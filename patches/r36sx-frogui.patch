+    font_draw_text(framebuffer,SCREEN_WIDTH,SCREEN_HEIGHT,x+UI_S(10),y+UI_S(8),label,fg);
+    int value_w=font_measure_text_scaled(value,80);
+    int value_x=x+w-value_w-UI_S(8);
+    int track_x=x+w*52/100, track_w=value_x-track_x-UI_S(9);
+    int track_y=y+h/2-UI_S(2), track_h=UI_S(4);
+    if(track_w<UI_S(30)) track_w=UI_S(30);
