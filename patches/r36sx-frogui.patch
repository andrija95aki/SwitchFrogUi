+/* Every application browser starts at the SD root. Keep its Back operation in
+ * one place so no app can accidentally compare against the ROM root or walk
+ * above /mnt/sdcard. This also repairs paths with an incidental trailing '/'. */
+static void utility_browser_go_back(void) {
+    size_t root_len = strlen(SDCARD_BASE);
+    size_t len = strlen(current_path);
+    char child_name[256] = "";
+    while (len > root_len && current_path[len - 1] == '/')
+        current_path[--len] = '\0';
+
+    if (strcmp(current_path, SDCARD_BASE) == 0) {
+        if (viewing_files) file_selected_count = 0;
+        if (viewing_files || viewing_editor || viewing_jsdev)
+            io_keyboard_test_stop();
+        return_to_home();
+        return;
+    }
+
+    const char *child = strrchr(current_path, '/');
+    if (child && child[1]) {
+        strncpy(child_name, child + 1, sizeof(child_name) - 1);
+        child_name[sizeof(child_name) - 1] = '\0';
+    }
+
+    if (strncmp(current_path, SDCARD_BASE, root_len) != 0 ||
+        current_path[root_len] != '/') {
+        strncpy(current_path, SDCARD_BASE, MAX_PATH_LEN - 1);
+        current_path[MAX_PATH_LEN - 1] = '\0';
+    } else {
+        char *slash = strrchr(current_path, '/');
+        if (!slash || slash <= current_path + root_len)
+            current_path[root_len] = '\0';
+        else
+            *slash = '\0';
+    }
+    /* Multi-selection follows the visible directory, like a desktop file
+     * manager.  Do not leave hidden selections armed after navigating away. */
+    if (viewing_files) file_selected_count = 0;
+    scan_directory(current_path);
+    if (!browser_history_pop(current_path, child_name)) {
+        scroll_offset = 0;
+        browser_select_name(child_name);
+    }
+}
