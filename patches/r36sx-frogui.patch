+static void render_virtual_keyboard_overlay(int selected_row, int selected_column) {
+    int panel_x = UI_S(12), panel_y = SCREEN_HEIGHT - UI_S(258);
+    int panel_w = SCREEN_WIDTH - UI_S(24), panel_h = UI_S(238);
+    int gap = UI_S(5), key_h = UI_S(31);
+    render_rounded_rect_aa(framebuffer, panel_x, panel_y, panel_w, panel_h,
+                           UI_S(12), ui_mix565(COLOR_BG, 0x0000, 112));
+    for (int row = 0; row < KBD_NROWS; row++) {
+        int count = kbd_row_len(row);
+        int key_w = row == KBD_SPECIAL_ROW ? UI_S(150) : UI_S(48);
+        int grid_w = count * key_w + (count - 1) * gap;
+        int start_x = (SCREEN_WIDTH - grid_w) / 2;
+        int y = panel_y + UI_S(12) + row * (key_h + gap);
+        for (int col = 0; col < count; col++) {
+            char label[12];
+            int x = start_x + col * (key_w + gap);
+            uint16_t bg = row == selected_row && col == selected_column ?
+                          COLOR_SELECT_BG : ui_mix565(COLOR_BG, COLOR_TEXT, 34);
+            uint16_t fg = row == selected_row && col == selected_column ?
+                          COLOR_SELECT_TEXT : COLOR_TEXT;
+            if (row == KBD_SPECIAL_ROW) snprintf(label, sizeof(label), "%s", KBD_SPECIAL[col]);
+            else { label[0] = (char)kbd_char_at(row, col); label[1] = '\0'; }
+            render_rounded_rect_aa(framebuffer, x, y, key_w, key_h, UI_S(6), bg);
+            int text_w = font_measure_text_scaled(label, row == KBD_SPECIAL_ROW ? 68 : 78);
+            font_draw_text_scaled(framebuffer, SCREEN_WIDTH, SCREEN_HEIGHT,
+                                  x + (key_w - text_w) / 2, y + UI_S(8), label, fg,
+                                  row == KBD_SPECIAL_ROW ? 68 : 78);
+        }
+    }
+    font_draw_text_scaled(framebuffer, SCREEN_WIDTH, SCREEN_HEIGHT, PADDING,
+                          SCREEN_HEIGHT - UI_S(15),
+                          "SELECT HIDE   L1 SYMBOLS   R1 CASE   A TYPE   Y DELETE",
+                          COLOR_LEGEND, 62);
+}
