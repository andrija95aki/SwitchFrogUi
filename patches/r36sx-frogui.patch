+        case KEY_KP7: return "KP 7"; case KEY_KP8: return "KP 8"; case KEY_KP9: return "KP 9";
+        case KEY_KPMINUS: return "KP -"; case KEY_KP4: return "KP 4"; case KEY_KP5: return "KP 5";
+        case KEY_KP6: return "KP 6"; case KEY_KPPLUS: return "KP +"; case KEY_KP1: return "KP 1";
+        case KEY_KP2: return "KP 2"; case KEY_KP3: return "KP 3"; case KEY_KP0: return "KP 0";
+        case KEY_KPDOT: return "KP ."; case KEY_KPENTER: return "KP ENTER";
+        case KEY_RIGHTCTRL: return "RIGHT CTRL"; case KEY_KPSLASH: return "KP /";
+        case KEY_SYSRQ: return "PRINT SCREEN"; case KEY_RIGHTALT: return "RIGHT ALT";
+        case KEY_HOME: return "HOME"; case KEY_UP: return "UP"; case KEY_PAGEUP: return "PAGE UP";
+        case KEY_LEFT: return "LEFT"; case KEY_RIGHT: return "RIGHT"; case KEY_END: return "END";
+        case KEY_DOWN: return "DOWN"; case KEY_PAGEDOWN: return "PAGE DOWN";
+        case KEY_INSERT: return "INSERT"; case KEY_DELETE: return "DELETE";
+        case KEY_LEFTMETA: return "LEFT META"; case KEY_RIGHTMETA: return "RIGHT META";
+        case KEY_COMPOSE: return "MENU"; case KEY_PAUSE: return "PAUSE";
+        case KEY_VOLUMEUP: return "VOLUME UP"; case KEY_VOLUMEDOWN: return "VOLUME DOWN";
+        case KEY_MUTE: return "MUTE"; case KEY_PLAYPAUSE: return "PLAY/PAUSE";
+        case KEY_STOPCD: return "MEDIA STOP"; case KEY_NEXTSONG: return "MEDIA NEXT";
+        case KEY_PREVIOUSSONG: return "MEDIA PREVIOUS";
+        default: break;
+    }
+    return NULL;
+}
+
+static void keyboard_queue_event(int code, int value) {
+    int next = (key_event_tail + 1) % KEY_EVENT_QUEUE_COUNT;
+    if (next == key_event_head) key_event_head = (key_event_head + 1) % KEY_EVENT_QUEUE_COUNT;
+    key_event_queue[key_event_tail].code = code;
+    key_event_queue[key_event_tail].value = value;
+    key_event_tail = next;
+}
+
+static void keyboard_build_held_text(void) {
+    size_t used = 0;
+    unsigned code;
+    keyboard_state.held[0] = '\0';
+    for (code = 0; code <= KEY_MAX; code++) {
+        const char *name;
+        int written;
+        if (!keyboard_held[code]) continue;
+        name = keyboard_key_name(code);
+        if (!name) continue;
+        written = snprintf(keyboard_state.held + used, sizeof(keyboard_state.held) - used,
+                           "%s%s", used ? " + " : "", name);
+        if (written < 0 || (size_t)written >= sizeof(keyboard_state.held) - used) break;
+        used += (size_t)written;
+    }
+    if (!keyboard_state.held[0]) snprintf(keyboard_state.held, sizeof(keyboard_state.held), "None");
+    snprintf(keyboard_state.modifiers, sizeof(keyboard_state.modifiers), "%s%s%s%s",
+             keyboard_held[KEY_LEFTSHIFT] || keyboard_held[KEY_RIGHTSHIFT] ? "SHIFT " : "",
+             keyboard_held[KEY_LEFTCTRL] || keyboard_held[KEY_RIGHTCTRL] ? "CTRL " : "",
+             keyboard_held[KEY_LEFTALT] || keyboard_held[KEY_RIGHTALT] ? "ALT " : "",
+             keyboard_held[KEY_LEFTMETA] || keyboard_held[KEY_RIGHTMETA] ? "META" : "");
+    if (!keyboard_state.modifiers[0])
+        snprintf(keyboard_state.modifiers, sizeof(keyboard_state.modifiers), "None");
+}
+
+static void keyboard_add_history(const char *name, int down) {
+    int i;
+    for (i = IO_KEYBOARD_HISTORY_COUNT - 1; i > 0; i--)
+        snprintf(keyboard_state.recent[i], sizeof(keyboard_state.recent[i]), "%s",
+                 keyboard_state.recent[i - 1]);
+    snprintf(keyboard_state.recent[0], sizeof(keyboard_state.recent[0]), "%s  %s",
+             name, down ? "DOWN" : "UP");
+}
+
+void io_keyboard_test_start(void) {
+    io_keyboard_test_stop();
+    memset(&keyboard_state, 0, sizeof(keyboard_state));
+    memset(keyboard_held, 0, sizeof(keyboard_held));
+    keyboard_poll_counter = 0;
+    key_event_head = key_event_tail = 0;
+    capture_armed = capture_wait_release = 0;
+    keyboard_test_running = 1;
+    snprintf(keyboard_state.held, sizeof(keyboard_state.held), "None");
+    snprintf(keyboard_state.modifiers, sizeof(keyboard_state.modifiers), "None");
+    keyboard_scan_devices();
+}
+
+int io_keyboard_test_poll(void) {
+    int changed = 0;
+    int i = 0;
+    unsigned old_revision;
+    if (!keyboard_test_running) return 0;
+    old_revision = keyboard_state.revision;
+    keyboard_poll_counter++;
+    if ((keyboard_device_count == 0 && (keyboard_poll_counter % 60u) == 1u) ||
+        (keyboard_poll_counter % 120u) == 0u)
+        keyboard_scan_devices();
+    while (i < keyboard_device_count) {
+        KeyboardDevice *device = &keyboard_devices[i];
+        struct input_event event;
+        ssize_t got;
+        int remove_device = 0;
+        while ((got = read(device->fd, &event, sizeof(event))) == (ssize_t)sizeof(event)) {
+            const char *name;
+            if (event.type != EV_KEY || event.code > KEY_MAX || event.value == 2) continue;
+            name = keyboard_key_name(event.code);
+            if (!name) continue;
+            keyboard_held[event.code] = event.value ? 1 : 0;
+            keyboard_queue_event((int)event.code, event.value ? 1 : 0);
+            keyboard_add_history(name, event.value != 0);
+            keyboard_state.event_count++;
+            keyboard_state.revision++;
+            snprintf(keyboard_state.device, sizeof(keyboard_state.device), "%s", device->path);
+            snprintf(keyboard_state.name, sizeof(keyboard_state.name), "%s", device->name);
+            changed = 1;
+        }
+        if (got < 0 && errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR)
+            remove_device = 1;
+        if (remove_device) {
+            close(device->fd);
+            if (i + 1 < keyboard_device_count)
+                memmove(&keyboard_devices[i], &keyboard_devices[i + 1],
+                        (size_t)(keyboard_device_count - i - 1) * sizeof(keyboard_devices[0]));
+            keyboard_device_count--;
+            memset(keyboard_held, 0, sizeof(keyboard_held));
+            keyboard_state.device[0] = '\0';
+            keyboard_state.revision++;
+            changed = 1;
+            continue;
+        }
+        i++;
+    }
+    if (changed) keyboard_build_held_text();
+    keyboard_refresh_connection_summary();
+    return changed || keyboard_state.revision != old_revision;
+}
+
+void io_keyboard_test_clear(void) {
+    memset(keyboard_state.recent, 0, sizeof(keyboard_state.recent));
+    keyboard_state.event_count = 0;
+    keyboard_state.revision++;
+}
+
+void io_keyboard_test_stop(void) {
+    int i;
+    for (i = 0; i < keyboard_device_count; i++) {
+        if (keyboard_devices[i].fd >= 0) close(keyboard_devices[i].fd);
+    }
+    memset(keyboard_devices, 0, sizeof(keyboard_devices));
+    keyboard_device_count = 0;
+    keyboard_test_running = 0;
+}
+
+const IoKeyboardTestState *io_keyboard_test_get_state(void) {
+    return &keyboard_state;
+}
+
+int io_keyboard_connected(void) {
+    return keyboard_device_count > 0;
+}
+
+void io_keyboard_mapping_reset_defaults(void) {
+    memcpy(mapping_codes, mapping_defaults, sizeof(mapping_codes));
+}
+
+void io_keyboard_mapping_load(void) {
+    FILE *f;
+    char line[96];
+    io_keyboard_mapping_reset_defaults();
+    f = fopen(KEYBOARD_MAPPING_PATH, "rb");
+    if (!f) return;
+    while (fgets(line, sizeof(line), f)) {
+        char label[32];
+        int code;
+        if (sscanf(line, "%31[^=]=%d", label, &code) != 2 || code < 0 || code > KEY_MAX) continue;
+        for (int i = 0; i < IO_KEYBOARD_MAPPING_COUNT; i++)
+            if (!strcasecmp(label, mapping_labels[i])) { mapping_codes[i] = code; break; }
+    }
+    fclose(f);
+}
+
+int io_keyboard_mapping_save(void) {
+    FILE *f;
+    mkdir("/mnt/sdcard/frogui", 0755);
+    f = fopen(KEYBOARD_MAPPING_PATH ".tmp", "wb");
+    if (!f) return 0;
+    fputs("# SwitchFrogUI Linux evdev key codes\n", f);
+    for (int i = 0; i < IO_KEYBOARD_MAPPING_COUNT; i++)
+        fprintf(f, "%s=%d\n", mapping_labels[i], mapping_codes[i]);
+    if (fclose(f) != 0 || rename(KEYBOARD_MAPPING_PATH ".tmp", KEYBOARD_MAPPING_PATH) != 0) {
+        unlink(KEYBOARD_MAPPING_PATH ".tmp");
+        return 0;
+    }
+    return 1;
+}
+
+const char *io_keyboard_mapping_label(int index) {
+    return index >= 0 && index < IO_KEYBOARD_MAPPING_COUNT ? mapping_labels[index] : "Button";
+}
+
+int io_keyboard_mapping_code(int index) {
+    return index >= 0 && index < IO_KEYBOARD_MAPPING_COUNT ? mapping_codes[index] : -1;
+}
+
+const char *io_keyboard_mapping_key_name(int index) {
+    const char *name;
+    int code = io_keyboard_mapping_code(index);
+    name = code >= 0 ? keyboard_key_name((unsigned)code) : NULL;
+    return name ? name : "UNMAPPED";
+}
+
+void io_keyboard_mapping_set_code(int index, int code) {
+    if (index >= 0 && index < IO_KEYBOARD_MAPPING_COUNT && code >= 0 && code <= KEY_MAX)
+        mapping_codes[index] = code;
+}
+
+void io_keyboard_capture_arm(void) {
+    capture_armed = 1;
+    capture_wait_release = 1;
+    key_event_head = key_event_tail = 0;
+}
+
+int io_keyboard_capture_poll(int *code) {
+    int event_code, event_value;
+    io_keyboard_test_poll();
+    if (!capture_armed) return 0;
+    if (capture_wait_release) {
+        for (int i = 0; i <= KEY_MAX; i++) if (keyboard_held[i]) return 0;
+        capture_wait_release = 0;
+        key_event_head = key_event_tail = 0;
+        return 0;
+    }
+    while (io_keyboard_pop_event(&event_code, &event_value)) {
+        if (event_value) {
+            capture_armed = 0;
+            if (code) *code = event_code;
+            return 1;
+        }
+    }
+    return 0;
+}
+
+int io_keyboard_pop_event(int *code, int *value) {
+    if (key_event_head == key_event_tail) return 0;
+    if (code) *code = key_event_queue[key_event_head].code;
+    if (value) *value = key_event_queue[key_event_head].value;
+    key_event_head = (key_event_head + 1) % KEY_EVENT_QUEUE_COUNT;
+    return 1;
+}
+
+void io_keyboard_discard_events(void) {
+    key_event_head = key_event_tail = 0;
+}
+
+int io_keyboard_shift_held(void) {
+    return keyboard_held[KEY_LEFTSHIFT] || keyboard_held[KEY_RIGHTSHIFT];
+}
+
+int io_keyboard_ctrl_held(void) {
+    return keyboard_held[KEY_LEFTCTRL] || keyboard_held[KEY_RIGHTCTRL];
+}
+
+int io_keyboard_key_to_ascii(int code, int shifted) {
+    static const char normal[] = "1234567890-=";
+    static const char upper[] = "!@#$%^&*()_+";
+    if (code >= KEY_1 && code <= KEY_EQUAL) return (shifted ? upper : normal)[code - KEY_1];
+    if (code >= KEY_Q && code <= KEY_P) return (shifted ? "QWERTYUIOP" : "qwertyuiop")[code - KEY_Q];
+    if (code >= KEY_A && code <= KEY_L) return (shifted ? "ASDFGHJKL" : "asdfghjkl")[code - KEY_A];
+    if (code >= KEY_Z && code <= KEY_M) return (shifted ? "ZXCVBNM" : "zxcvbnm")[code - KEY_Z];
+    switch (code) {
+        case KEY_SPACE: return ' '; case KEY_TAB: return '\t';
+        case KEY_LEFTBRACE: return shifted ? '{' : '['; case KEY_RIGHTBRACE: return shifted ? '}' : ']';
+        case KEY_SEMICOLON: return shifted ? ':' : ';'; case KEY_APOSTROPHE: return shifted ? '"' : '\'';
+        case KEY_GRAVE: return shifted ? '~' : '`'; case KEY_BACKSLASH: return shifted ? '|' : '\\';
+        case KEY_COMMA: return shifted ? '<' : ','; case KEY_DOT: return shifted ? '>' : '.';
+        case KEY_SLASH: return shifted ? '?' : '/'; default: return 0;
+    }
+}
+
+#define MOUSE_MAX_DEVICES 4
+static int mouse_fds[MOUSE_MAX_DEVICES], mouse_fd_count;
+static int fd_is_mouse(int fd) {
+    unsigned long ev_bits[BIT_ARRAY_LONGS(EV_MAX)] = {0};
+    unsigned long rel_bits[BIT_ARRAY_LONGS(REL_MAX)] = {0};
+    if (ioctl(fd, EVIOCGBIT(0, sizeof(ev_bits)), ev_bits) < 0 || !bit_is_set(ev_bits, EV_REL)) return 0;
+    if (ioctl(fd, EVIOCGBIT(EV_REL, sizeof(rel_bits)), rel_bits) < 0) return 0;
+    return bit_is_set(rel_bits, REL_X) && bit_is_set(rel_bits, REL_Y);
+}
+
+void io_mouse_start(void) {
+    DIR *dir; struct dirent *entry;
+    io_mouse_stop();
+    dir = opendir("/dev/input"); if (!dir) return;
+    while ((entry = readdir(dir)) && mouse_fd_count < MOUSE_MAX_DEVICES) {
+        char path[40]; int fd;
+        if (strncmp(entry->d_name, "event", 5)) continue;
+        snprintf(path, sizeof(path), "/dev/input/%s", entry->d_name);
+        fd = open(path, O_RDONLY | O_NONBLOCK);
+        if (fd >= 0 && fd_is_mouse(fd)) mouse_fds[mouse_fd_count++] = fd; else if (fd >= 0) close(fd);
+    }
+    closedir(dir);
+}
+
+int io_mouse_poll(IoMouseState *state) {
+    int changed = 0;
+    if (!state) return 0;
+    state->dx = state->dy = state->left_pressed = 0;
+    state->connected = mouse_fd_count;
+    for (int i = 0; i < mouse_fd_count; i++) {
+        struct input_event event;
+        while (read(mouse_fds[i], &event, sizeof(event)) == (ssize_t)sizeof(event)) {
+            if (event.type == EV_REL && event.code == REL_X) { state->dx += event.value; changed = 1; }
+            else if (event.type == EV_REL && event.code == REL_Y) { state->dy += event.value; changed = 1; }
+            else if (event.type == EV_KEY && event.code == BTN_LEFT) {
+                if (event.value && !state->left_down) state->left_pressed = 1;
+                state->left_down = event.value ? 1 : 0; changed = 1;
+            }
+        }
+    }
+    return changed;
+}
+
+void io_mouse_stop(void) {
+    for (int i = 0; i < mouse_fd_count; i++) close(mouse_fds[i]);
+    mouse_fd_count = 0;
+}
+
+static int starts_with(const char *text, const char *prefix) {
+    return text && prefix && strncmp(text, prefix, strlen(prefix)) == 0;
+}
+
+static int contains_case(const char *text, const char *needle) {
+    size_t n;
+    if (!text || !needle || !needle[0]) return 0;
+    n = strlen(needle);
+    while (*text) {
+        if (strncasecmp(text, needle, n) == 0) return 1;
+        text++;
+    }
+    return 0;
+}
+
+static int path_exists(const char *path) {
+    struct stat st;
+    return path && stat(path, &st) == 0;
+}
+
+static int read_value(const char *path, char *out, size_t size) {
+    FILE *f;
+    size_t got;
+    if (!out || size < 2) return 0;
+    out[0] = '\0';
+    f = fopen(path, "rb");
+    if (!f) return 0;
+    got = fread(out, 1, size - 1, f);
+    fclose(f);
+    out[got] = '\0';
+    while (got && (unsigned char)out[got - 1] <= ' ') out[--got] = '\0';
+    return got != 0;
+}
+
+static void add_row(const char *label, const char *value) {
+    IoDiagnosticRow *row;
+    if (row_count >= IO_DIAGNOSTICS_MAX_ROWS) return;
+    row = &rows[row_count++];
+    snprintf(row->label, sizeof(row->label), "%s", label ? label : "Device");
+    snprintf(row->value, sizeof(row->value), "%s", value && value[0] ? value : "Not detected");
+}
+
+static int count_dir_entries(const char *path, const char *prefix, int digits_only) {
+    DIR *dir = opendir(path);
+    struct dirent *entry;
+    int count = 0;
+    if (!dir) return 0;
+    while ((entry = readdir(dir))) {
+        const char *tail;
+        if (entry->d_name[0] == '.') continue;
+        if (prefix && !starts_with(entry->d_name, prefix)) continue;
+        tail = prefix ? entry->d_name + strlen(prefix) : entry->d_name;
+        if (digits_only && (!tail[0] || !isdigit((unsigned char)tail[0]))) continue;
+        count++;
+    }
+    closedir(dir);
+    return count;
+}
+
+static int count_base_block_devices(const char *prefix) {
+    DIR *dir = opendir("/sys/class/block");
+    struct dirent *entry;
+    int count = 0;
+    if (!dir) return 0;
+    while ((entry = readdir(dir))) {
+        const char *name = entry->d_name;
+        if (!starts_with(name, prefix)) continue;
+        if (!strcmp(prefix, "mmcblk")) {
+            const char *p = name + strlen(prefix);
+            while (isdigit((unsigned char)*p)) p++;
+            if (*p) continue; /* partition or boot/RPMB node */
+        } else if (!strcmp(prefix, "sd")) {
+            if (strlen(name) != 3 || !isalpha((unsigned char)name[2])) continue;
+        }
+        count++;
+    }
+    closedir(dir);
+    return count;
+}
+
+static int block_device_readable(const char *name) {
+    char path[96];
+    unsigned char byte;
+    FILE *f;
+    size_t got;
+    snprintf(path, sizeof(path), "/dev/%s", name);
+    f = fopen(path, "rb");
+    if (!f) return 0;
+    got = fread(&byte, 1, 1, f);
+    fclose(f);
+    return got == 1;
+}
+
+static int count_readable_block_devices(const char *prefix) {
+    DIR *dir = opendir("/sys/class/block");
+    struct dirent *entry;
+    int count = 0;
+    if (!dir) return 0;
+    while ((entry = readdir(dir))) {
+        const char *name = entry->d_name;
+        const char *p;
+        if (!starts_with(name, prefix)) continue;
+        if (!strcmp(prefix, "mmcblk")) {
+            p = name + strlen(prefix);
+            while (isdigit((unsigned char)*p)) p++;
+            if (*p) continue;
+        } else if (!strcmp(prefix, "sd")) {
+            if (strlen(name) != 3 || !isalpha((unsigned char)name[2])) continue;
+        }
+        if (block_device_readable(name)) count++;
+    }
+    closedir(dir);
+    return count;
+}
+
+static void add_block_rows(const char *prefix, const char *label) {
+    DIR *dir = opendir("/sys/class/block");
+    struct dirent *entry;
+    if (!dir) return;
+    while ((entry = readdir(dir))) {
+        const char *name = entry->d_name;
+        char path[256], model[64] = "", sectors[32] = "", value[96];
+        unsigned long long nsectors = 0;
+        if (!starts_with(name, prefix)) continue;
+        if (!strcmp(prefix, "mmcblk")) {
+            const char *p = name + strlen(prefix);
+            while (isdigit((unsigned char)*p)) p++;
+            if (*p) continue;
+        } else if (!strcmp(prefix, "sd")) {
+            if (strlen(name) != 3 || !isalpha((unsigned char)name[2])) continue;
+        }
+        snprintf(path, sizeof(path), "/sys/class/block/%s/device/model", name);
+        read_value(path, model, sizeof(model));
+        snprintf(path, sizeof(path), "/sys/class/block/%s/size", name);
+        read_value(path, sectors, sizeof(sectors));
+        if (sectors[0]) sscanf(sectors, "%llu", &nsectors);
+        if (model[0] && nsectors)
+            snprintf(value, sizeof(value), "%s: %s, %llu MiB, %s", name, model,
+                     nsectors / 2048ULL, block_device_readable(name) ? "read OK" : "read denied");
+        else if (nsectors)
+            snprintf(value, sizeof(value), "%s: %llu MiB, %s", name, nsectors / 2048ULL,
+                     block_device_readable(name) ? "read OK" : "read denied");
+        else
+            snprintf(value, sizeof(value), "%s", name);
+        add_row(label, value);
+    }
+    closedir(dir);
+}
+
+static int read_card_mount(char *out, size_t out_size) {
+    FILE *f = fopen("/proc/mounts", "r");
+    char source[128], target[128], type[48], options[192];
+    int dump, pass;
+    if (!f) return 0;
+    while (fscanf(f, "%127s %127s %47s %191s %d %d\n",
+                  source, target, type, options, &dump, &pass) == 6) {
+        if (!strcmp(target, "/mnt/sdcard")) {
+            snprintf(out, out_size, "%s (%s)", source, type);
+            fclose(f);
+            return 1;
+        }
+    }
+    fclose(f);
+    return 0;
+}
+
+static void probe_mmc(void) {
+    int hosts = count_dir_entries("/sys/class/mmc_host", "mmc", 1);
+    int cards = count_base_block_devices("mmcblk");
+    int readable = count_readable_block_devices("mmcblk");
+    char value[96], mount[96];
+    snprintf(value, sizeof(value), "%d controller%s exposed", hosts, hosts == 1 ? "" : "s");
+    add_row("SD/MMC interfaces", value);
+    snprintf(value, sizeof(value), "%d detected, %d read-test OK", cards, readable);
+    add_row("SD cards", value);
+    add_row("Second SD slot", cards >= 2
+                ? (readable >= 2 ? "Detected; non-writing read test OK" : "Detected; read test denied")
+                : "Not detected - insert card + X");
+    if (read_card_mount(mount, sizeof(mount))) add_row("System card mount", mount);
+    else add_row("System card mount", "Mount source unavailable");
+    add_block_rows("mmcblk", "SD block device");
+}
+
+static void probe_usb(void) {
+    DIR *dir = opendir("/sys/bus/usb/devices");
+    struct dirent *entry;
+    int hosts = 0, devices = 0, ports = 0;
+    char value[96];
+    if (dir) {
+        while ((entry = readdir(dir))) {
+            char path[256], vendor[16], product_id[16], product[64], maxchild[16];
+            if (starts_with(entry->d_name, "usb") && isdigit((unsigned char)entry->d_name[3])) {
+                hosts++;
+                snprintf(path, sizeof(path), "/sys/bus/usb/devices/%s/maxchild", entry->d_name);
+                if (read_value(path, maxchild, sizeof(maxchild))) ports += atoi(maxchild);
+                continue;
+            }
+            snprintf(path, sizeof(path), "/sys/bus/usb/devices/%s/idVendor", entry->d_name);
+            if (!read_value(path, vendor, sizeof(vendor))) continue;
+            snprintf(path, sizeof(path), "/sys/bus/usb/devices/%s/idProduct", entry->d_name);
+            read_value(path, product_id, sizeof(product_id));
+            snprintf(path, sizeof(path), "/sys/bus/usb/devices/%s/product", entry->d_name);
+            if (!read_value(path, product, sizeof(product))) snprintf(product, sizeof(product), "USB %s:%s", vendor, product_id);
+            devices++;
+            snprintf(value, sizeof(value), "%s [%s:%s]", product, vendor, product_id);
+            add_row("USB device", value);
+        }
+        closedir(dir);
+    }
+    snprintf(value, sizeof(value), "%d bus%s, %d port%s exposed", hosts, hosts == 1 ? "" : "es",
+             ports, ports == 1 ? "" : "s");
+    add_row("USB host / OTG", hosts ? value : "No active USB host bus");
+    snprintf(value, sizeof(value), "%d non-root device%s", devices, devices == 1 ? "" : "s");
+    add_row("USB connected", value);
+    add_row("USB HID support",
+            path_exists("/sys/bus/usb/drivers/usbhid") || path_exists("/sys/module/usbhid")
+                ? "Driver available - keyboard/mouse testable"
+                : "HID driver not currently exposed");
+    add_block_rows("sd", "USB storage");
+}
+
+static void probe_inputs(void) {
+    FILE *f = fopen("/proc/bus/input/devices", "r");
+    char line[256], name[128] = "", handlers[128] = "";
+    int keyboards = 0, mice = 0, gamepads = 0, total = 0;
+    char value[96];
+    if (f) {
+        while (fgets(line, sizeof(line), f)) {
+            if (starts_with(line, "N: Name=")) {
+                char *p = strchr(line, '=');
+                if (p) {
+                    snprintf(name, sizeof(name), "%s", p + 1);
+                    while (name[0] && (name[strlen(name)-1] == '\n' || name[strlen(name)-1] == '\r')) name[strlen(name)-1] = '\0';
+                    if (name[0] == '"') memmove(name, name + 1, strlen(name));
+                    if (name[0] && name[strlen(name)-1] == '"') name[strlen(name)-1] = '\0';
+                }
+            } else if (starts_with(line, "H: Handlers=")) {
+                char *p = strchr(line, '=');
+                snprintf(handlers, sizeof(handlers), "%s", p ? p + 1 : "");
+            } else if (line[0] == '\n' && name[0]) {
+                const char *kind = "Input device";
+                if (strstr(handlers, "kbd")) { kind = "Keyboard"; keyboards++; }
+                else if (strstr(handlers, "mouse")) { kind = "Mouse"; mice++; }
+                else if (strstr(handlers, "js") || contains_case(name, "gamepad") ||
+                         contains_case(name, "joystick") || contains_case(name, "controller")) {
+                    kind = "Gamepad"; gamepads++;
+                }
+                add_row(kind, name);
+                total++;
+                name[0] = handlers[0] = '\0';
+            }
+        }
+        if (name[0]) { add_row("Input device", name); total++; }
+        fclose(f);
+    }
+    snprintf(value, sizeof(value), "%d device%s / %d event node%s", total, total == 1 ? "" : "s",
+             count_dir_entries("/dev/input", "event", 1),
+             count_dir_entries("/dev/input", "event", 1) == 1 ? "" : "s");
+    add_row("Linux input", value);
+    snprintf(value, sizeof(value), "%d keyboard, %d mouse, %d gamepad", keyboards, mice, gamepads);
+    add_row("HID summary", value);
+}
+
+static void probe_audio_video(void) {
+    int cards = count_dir_entries("/sys/class/sound", "card", 1);
+    int pcm = count_dir_entries("/dev/snd", "pcm", 0);
+    int fb = count_dir_entries("/dev", "fb", 1);
+    int backlights = count_dir_entries("/sys/class/backlight", NULL, 0);
+    char state[32], value[96];
+    snprintf(value, sizeof(value), "%d card%s, %d PCM endpoint%s", cards, cards == 1 ? "" : "s",
+             pcm, pcm == 1 ? "" : "s");
+    add_row("Audio output", value);
+    if (read_value("/sys/class/switch/h2w/state", state, sizeof(state)) ||
+        read_value("/sys/class/switch/headset/state", state, sizeof(state)) ||
+        read_value("/sys/class/switch/headphone/state", state, sizeof(state))) {
+        snprintf(value, sizeof(value), "Jack detect state: %s", state);
+        add_row("Headphone jack", value);
+    } else {
+        add_row("Headphone jack", pcm ? "Output available; insertion not exposed" : "Not exposed by kernel");
+    }
+    snprintf(value, sizeof(value), "%d framebuffer%s, %d backlight%s", fb, fb == 1 ? "" : "s",
+             backlights, backlights == 1 ? "" : "s");
+    add_row("Display output", value);
+}
+
+static void probe_other_io(void) {
+    int serial = count_dir_entries("/dev", "ttyUSB", 1) + count_dir_entries("/dev", "ttyACM", 1);
+    int hidraw = count_dir_entries("/dev", "hidraw", 1);
+    int net = count_dir_entries("/sys/class/net", NULL, 0);
+    char value[96];
+    snprintf(value, sizeof(value), "%d serial, %d raw HID", serial, hidraw);
+    add_row("Other USB I/O", value);
+    snprintf(value, sizeof(value), "%d interface%s (including loopback)", net, net == 1 ? "" : "s");
+    add_row("Network", value);
+}
+
+static void report_copy_file(FILE *report, const char *title, const char *path) {
+    FILE *source;
+    char line[512];
+    fprintf(report, "\n[%s: %s]\n", title, path);
+    source = fopen(path, "r");
+    if (!source) { fprintf(report, "unavailable\n"); return; }
+    while (fgets(line, sizeof(line), source)) fputs(line, report);
+    fclose(source);
+}
+
+static void report_list_dir(FILE *report, const char *path) {
+    DIR *dir = opendir(path);
+    struct dirent *entry;
+    fprintf(report, "\n[Directory: %s]\n", path);
+    if (!dir) { fprintf(report, "unavailable\n"); return; }
+    while ((entry = readdir(dir))) if (entry->d_name[0] != '.') fprintf(report, "%s\n", entry->d_name);
+    closedir(dir);
+}
+
+static void write_report(void) {
+    FILE *report = fopen(REPORT_PATH, "w");
+    int i;
+    if (!report) return;
+    fprintf(report, "SwitchFrogUI I/O diagnostics\n");
+    fprintf(report, "Generated live from Linux procfs/sysfs. Re-run with X after connecting hardware.\n\n");
+    for (i = 0; i < row_count; i++) fprintf(report, "%-22s %s\n", rows[i].label, rows[i].value);
+    report_copy_file(report, "mounts", "/proc/mounts");
+    report_copy_file(report, "partitions", "/proc/partitions");
+    report_copy_file(report, "input devices", "/proc/bus/input/devices");
+    report_copy_file(report, "ALSA cards", "/proc/asound/cards");
+    report_copy_file(report, "ALSA PCM", "/proc/asound/pcm");
+    report_list_dir(report, "/sys/class/mmc_host");
+    report_list_dir(report, "/sys/class/block");
+    report_list_dir(report, "/sys/bus/usb/devices");
+    report_list_dir(report, "/dev/input");
+    report_list_dir(report, "/dev/snd");
+    report_list_dir(report, "/dev");
+    fflush(report);
+    fsync(fileno(report));
+    fclose(report);
+    sync();
+}
+
+void io_diagnostics_refresh(void) {
+    row_count = 0;
+    add_row("How to test", "Insert device/card, then press X");
+    probe_mmc();
+    probe_usb();
+    probe_inputs();
+    probe_audio_video();
+    probe_other_io();
+    add_row("Full report", "frogui/io_diagnostics.txt");
+    write_report();
+}
+
+int io_diagnostics_get_count(void) {
+    return row_count;
+}
+
+const IoDiagnosticRow *io_diagnostics_get_row(int index) {
+    if (index < 0 || index >= row_count) return NULL;
+    return &rows[index];
+}
+
+const char *io_diagnostics_report_path(void) {
+    return REPORT_PATH;
+}
