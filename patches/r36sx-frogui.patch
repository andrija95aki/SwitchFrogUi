+#define KEYBOARD_TEST_MAX_DEVICES 8
+#define BITS_PER_LONG (sizeof(unsigned long) * 8u)
+#define BIT_WORD(bit) ((unsigned)(bit) / BITS_PER_LONG)
+#define BIT_MASK(bit) (1ul << ((unsigned)(bit) % BITS_PER_LONG))
+#define BIT_ARRAY_LONGS(max_bit) (((unsigned)(max_bit) / BITS_PER_LONG) + 1u)
+
+typedef struct {
+    int fd;
+    char path[32];
+    char name[64];
+} KeyboardDevice;
+
+static KeyboardDevice keyboard_devices[KEYBOARD_TEST_MAX_DEVICES];
+static int keyboard_device_count;
+static unsigned char keyboard_held[KEY_MAX + 1];
+static unsigned keyboard_poll_counter;
+static int keyboard_test_running;
+static IoKeyboardTestState keyboard_state;
+
+typedef struct { int code, value; } QueuedKeyEvent;
+#define KEY_EVENT_QUEUE_COUNT 64
+static QueuedKeyEvent key_event_queue[KEY_EVENT_QUEUE_COUNT];
+static int key_event_head, key_event_tail;
+static int capture_wait_release, capture_armed;
+
+static const char *mapping_labels[IO_KEYBOARD_MAPPING_COUNT] = {
+    "D-pad Up", "D-pad Down", "D-pad Left", "D-pad Right",
+    "A", "B", "X", "Y", "L1", "R1", "L2", "R2", "Select", "Start"
+};
+static const int mapping_defaults[IO_KEYBOARD_MAPPING_COUNT] = {
+    KEY_UP, KEY_DOWN, KEY_LEFT, KEY_RIGHT,
+    KEY_ENTER, KEY_ESC, KEY_SPACE, KEY_LEFTSHIFT,
+    KEY_Q, KEY_E, KEY_1, KEY_3, KEY_BACKSPACE, KEY_RIGHTSHIFT
+};
+static int mapping_codes[IO_KEYBOARD_MAPPING_COUNT];
+
+static int bit_is_set(const unsigned long *bits, unsigned bit) {
+    return (bits[BIT_WORD(bit)] & BIT_MASK(bit)) != 0;
+}
+
+static int keyboard_path_open(const char *path) {
+    int i;
+    for (i = 0; i < keyboard_device_count; i++)
+        if (!strcmp(keyboard_devices[i].path, path)) return 1;
+    return 0;
+}
+
+static int fd_is_keyboard(int fd) {
+    unsigned long ev_bits[BIT_ARRAY_LONGS(EV_MAX)];
+    unsigned long key_bits[BIT_ARRAY_LONGS(KEY_MAX)];
+    memset(ev_bits, 0, sizeof(ev_bits));
+    memset(key_bits, 0, sizeof(key_bits));
+    if (ioctl(fd, EVIOCGBIT(0, sizeof(ev_bits)), ev_bits) < 0 ||
+        !bit_is_set(ev_bits, EV_KEY)) return 0;
+    if (ioctl(fd, EVIOCGBIT(EV_KEY, sizeof(key_bits)), key_bits) < 0) return 0;
+    /* Avoid treating the built-in gamepad as a keyboard. A normal USB
+     * keyboard exposes letters, Space and Enter even when it has extra HID
+     * consumer-control event nodes. */
+    return bit_is_set(key_bits, KEY_A) && bit_is_set(key_bits, KEY_Z) &&
+           bit_is_set(key_bits, KEY_SPACE) && bit_is_set(key_bits, KEY_ENTER);
+}
+
+static void keyboard_refresh_connection_summary(void) {
+    if (keyboard_device_count > 0) {
+        keyboard_state.connected = keyboard_device_count;
+        if (!keyboard_state.device[0]) {
+            snprintf(keyboard_state.device, sizeof(keyboard_state.device), "%s",
+                     keyboard_devices[0].path);
+            snprintf(keyboard_state.name, sizeof(keyboard_state.name), "%s",
+                     keyboard_devices[0].name);
+        }
+    } else {
+        keyboard_state.connected = 0;
+        keyboard_state.device[0] = '\0';
+        snprintf(keyboard_state.name, sizeof(keyboard_state.name), "Waiting for USB keyboard");
+    }
+}
+
+static void keyboard_scan_devices(void) {
+    DIR *dir = opendir("/dev/input");
+    struct dirent *entry;
+    int old_count = keyboard_device_count;
+    if (!dir) {
+        keyboard_refresh_connection_summary();
+        return;
+    }
+    while ((entry = readdir(dir)) && keyboard_device_count < KEYBOARD_TEST_MAX_DEVICES) {
+        KeyboardDevice *device;
+        char path[32];
+        int fd;
+        if (strncmp(entry->d_name, "event", 5) || !isdigit((unsigned char)entry->d_name[5]))
+            continue;
+        snprintf(path, sizeof(path), "/dev/input/%s", entry->d_name);
+        if (keyboard_path_open(path)) continue;
+        fd = open(path, O_RDONLY | O_NONBLOCK);
+        if (fd < 0) continue;
+        if (!fd_is_keyboard(fd)) {
+            close(fd);
+            continue;
+        }
+        device = &keyboard_devices[keyboard_device_count++];
+        memset(device, 0, sizeof(*device));
+        device->fd = fd;
+        snprintf(device->path, sizeof(device->path), "%s", path);
+        if (ioctl(fd, EVIOCGNAME(sizeof(device->name)), device->name) < 0 || !device->name[0])
+            snprintf(device->name, sizeof(device->name), "Linux USB keyboard");
+    }
+    closedir(dir);
+    keyboard_refresh_connection_summary();
+    if (keyboard_device_count != old_count) keyboard_state.revision++;
+}
+
