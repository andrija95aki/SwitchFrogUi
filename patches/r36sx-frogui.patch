+                           UI_S(7), 0xFFE0);
+    }
+    char footer[128];
+    int pages = count > 0 ? (count + visible - 1) / visible : 1;
+    int page = count > 0 ? first / visible + 1 : 1;
+    snprintf(footer, sizeof(footer), "A DETAILS  B BACK  START ART GRID  L1/R1 PAGE   %d/%d", page, pages);
+    font_draw_text_scaled(framebuffer, SCREEN_WIDTH, SCREEN_HEIGHT, PADDING,
+                          SCREEN_HEIGHT - UI_S(18), footer, COLOR_LEGEND, 64);
+}
