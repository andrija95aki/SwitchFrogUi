+    return strcasecmp(name, ".res") == 0 || strcasecmp(name, "images") == 0 ||
+           strcasecmp(name, "Imgs") == 0 || strcasecmp(name, "media") == 0 ||
+           strcasecmp(name, "boxart") == 0;
+}
+
+static int is_metadata_file_name(const char *name) {
+    size_t nlen = strlen(name);
+    int is_p8png = nlen >= 7 && strcasecmp(name + nlen - 7, ".p8.png") == 0;
+    const char *ext = strrchr(name, '.');
+    if (!ext || is_p8png) return 0;
+    return strcasecmp(ext,".csv")==0 || strcasecmp(ext,".txt")==0 ||
+           strcasecmp(ext,".md")==0  || strcasecmp(ext,".sh")==0 ||
+           strcasecmp(ext,".xml")==0 || strcasecmp(ext,".jpg")==0 ||
+           strcasecmp(ext,".jpeg")==0 || strcasecmp(ext,".png")==0 ||
+           strcasecmp(ext,".webp")==0;
+}
+
+static int append_entry(const char *name, int is_dir) {
+    if (entry_count >= entry_capacity) {
+        int new_capacity = entry_capacity ? entry_capacity * 2 : INITIAL_ENTRIES_CAPACITY;
+        DirEntry *grown = realloc(entries, (size_t)new_capacity * sizeof(DirEntry));
+        if (!grown) return 0;
+        entries = grown;
+        entry_capacity = new_capacity;
+    }
+    strncpy(entries[entry_count].name, name, sizeof(entries[entry_count].name) - 1);
+    entries[entry_count].name[sizeof(entries[entry_count].name) - 1] = '\0';
+    entries[entry_count].is_dir = is_dir;
+    entries[entry_count].home_recent_index = -1;
+    entries[entry_count].category[0] = '\0';
+    entry_count++;
+    return 1;
+}
+
+/* Platform folders on stock cards often contain GB/GBC/region subfolders while
+ * artwork is stored separately. Present all ROMs as one flat artwork grid. */
+static int scan_platform_games(const char *root, const char *relative, int depth) {
+    if (depth > 6) return 1;
+    char dir_path[MAX_PATH_LEN];
+    if (relative && *relative)
+        snprintf(dir_path, sizeof(dir_path), "%s/%s", root, relative);
+    else
+        snprintf(dir_path, sizeof(dir_path), "%s", root);
+    if (directory_lock_index_for_path(dir_path) >= 0) return 1;
+    DIR *dir = opendir(dir_path);
+    if (!dir) return 1;
+    struct dirent *e;
+    while ((e = readdir(dir)) != NULL) {
+        if (e->d_name[0] == '.') continue;
+        char full[MAX_PATH_LEN];
+        snprintf(full, sizeof(full), "%s/%s", dir_path, e->d_name);
+        int is_dir = dirent_is_directory(full, e);
+        if (is_dir) {
+            if (is_artwork_dir_name(e->d_name)) continue;
+            char child[256];
+            if (relative && *relative)
+                snprintf(child, sizeof(child), "%s/%s", relative, e->d_name);
+            else
+                snprintf(child, sizeof(child), "%s", e->d_name);
+            if (!scan_platform_games(root, child, depth + 1)) { closedir(dir); return 0; }
+        } else if (!is_metadata_file_name(e->d_name)) {
+            char item[256];
+            if (relative && *relative)
+                snprintf(item, sizeof(item), "%s/%s", relative, e->d_name);
+            else
+                snprintf(item, sizeof(item), "%s", e->d_name);
+            if (!append_entry(item, 0)) { closedir(dir); return 0; }
+        }
+    }
+    closedir(dir);
+    return 1;
+}
