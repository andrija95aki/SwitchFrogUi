+#define ACTIVITY_MAX_GAMES 256
+typedef struct { char path[MAX_PATH_LEN]; long seconds; } ActivityGame;
+static ActivityGame activity_games[ACTIVITY_MAX_GAMES];
+static int activity_game_count;
+static long activity_total_seconds;
+
+static int activity_compare(const void *a, const void *b) {
+    const ActivityGame *ga = (const ActivityGame *)a;
+    const ActivityGame *gb = (const ActivityGame *)b;
+    return ga->seconds < gb->seconds ? 1 : ga->seconds > gb->seconds ? -1 : 0;
+}
+
+static void activity_refresh(void) {
+    FILE *file = fopen("/mnt/sdcard/frogui/playtime.txt", "r");
+    char line[MAX_PATH_LEN + 64];
+    activity_game_count = 0; activity_total_seconds = 0;
+    while (file && fgets(line, sizeof(line), file) &&
+           activity_game_count < ACTIVITY_MAX_GAMES) {
+        char *tab = strchr(line, '\t'); if (!tab) continue;
+        *tab++ = '\0'; tab[strcspn(tab, "\r\n")] = '\0';
+        long seconds = atol(line);
+        if (seconds <= 0 || !tab[0]) continue;
+        activity_games[activity_game_count].seconds = seconds;
+        snprintf(activity_games[activity_game_count].path,
+                 sizeof(activity_games[activity_game_count].path), "%s", tab);
+        activity_total_seconds += seconds;
+        activity_game_count++;
+    }
+    if (file) fclose(file);
+    if (activity_game_count > 1)
+        qsort(activity_games, (size_t)activity_game_count,
+              sizeof(activity_games[0]), activity_compare);
+    activity_scroll = 0;
+}
+
+static void activity_duration(long seconds, char *out, size_t n) {
+    if (seconds >= 3600) snprintf(out, n, "%ldh %02ldm", seconds / 3600,
+                                  (seconds % 3600) / 60);
+    else if (seconds >= 60) snprintf(out, n, "%ldm %02lds", seconds / 60,
+                                     seconds % 60);
+    else snprintf(out, n, "%lds", seconds);
+}
