+static Thumbnail *rom_card_get_art(int slot, const char *game_path) {
+    RomCardArt *a=&rom_card_art[slot];
+    if(!strcmp(a->path,game_path)) return a->thumb.data?&a->thumb:NULL;
+    if(a->thumb.data) thumbnail_owned_free(&a->thumb);
+    memset(&a->thumb,0,sizeof(a->thumb));
+    strncpy(a->path,game_path,sizeof(a->path)-1); a->path[sizeof(a->path)-1]='\0';
+    a->has_save=game_has_save(game_path)?1:0;
+    char art[MAX_PATH_LEN*2];
+    if(thumbnail_owned_load_game(game_path,&a->thumb)) return &a->thumb;
+    if(switcher_savestate_bmp(game_path,art,sizeof(art))) {
+        if(thumbnail_owned_load(art,&a->thumb)) return &a->thumb;
+    }
+    return NULL;
