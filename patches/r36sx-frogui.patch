+static void render_theme_sample(int x,int y,int w,int h,const Theme *t) {
+    int split=w*55/100;
+    for(int row=0;row<h;row++) {
+        uint16_t c=t->bg;
+        if(t->gradient) {
+            int d=h>1?h-1:1;
+            int ar=(t->bg>>11)&31,ag=(t->bg>>5)&63,ab=t->bg&31;
+            int br=(t->bg2>>11)&31,bg=(t->bg2>>5)&63,bb=t->bg2&31;
+            c=(uint16_t)((((ar*(d-row)+br*row)/d)<<11)|(((ag*(d-row)+bg*row)/d)<<5)|((ab*(d-row)+bb*row)/d));
+        }
+        render_fill_rect(framebuffer,x,y+row,split,1,c);
+    }
+    render_fill_rect(framebuffer,x+split,y,w-split,h,t->select_bg);
+    render_fill_rect(framebuffer,x+split+UI_S(4),y+UI_S(4),UI_S(8),h-UI_S(8),t->header);
+}
