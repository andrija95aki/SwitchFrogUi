+/* Load a small PCM16 WAV. Assets are normalized to mono/44.1 kHz at build
+ * time, but stereo is accepted so replacing a pack remains straightforward. */
+static int ui_sound_load_wav(const char *path, UiClip *clip) {
+    FILE *f=fopen(path,"rb");
+    if(!f) return 0;
+    unsigned char head[12];
+    if(fread(head,1,12,f)!=12 || memcmp(head,"RIFF",4) || memcmp(head+8,"WAVE",4)) { fclose(f); return 0; }
+    unsigned channels=0, rate=0, bits=0, format=0, data_size=0;
+    long data_pos=0;
+    for(;;) {
+        unsigned char ch[8];
+        if(fread(ch,1,8,f)!=8) break;
+        unsigned size=wav_u32(ch+4); long next=ftell(f)+(long)size+(size&1u);
+        if(!memcmp(ch,"fmt ",4) && size>=16) {
+            unsigned char fmt[16]; if(fread(fmt,1,16,f)!=16) break;
+            format=wav_u16(fmt); channels=wav_u16(fmt+2); rate=wav_u32(fmt+4); bits=wav_u16(fmt+14);
+        } else if(!memcmp(ch,"data",4)) { data_pos=ftell(f); data_size=size; }
+        fseek(f,next,SEEK_SET);
+        if(data_pos && format) break;
+    }
+    if(format!=1 || (channels!=1 && channels!=2) || rate!=44100 || bits!=16 || !data_pos || data_size<2) { fclose(f); return 0; }
+    int source_frames=(int)(data_size/(channels*2));
+    int16_t *source=(int16_t*)malloc(data_size), *mono=(int16_t*)malloc((size_t)source_frames*sizeof(int16_t));
+    if(!source || !mono) { free(source); free(mono); fclose(f); return 0; }
+    fseek(f,data_pos,SEEK_SET);
+    if(fread(source,1,data_size,f)!=data_size) { free(source); free(mono); fclose(f); return 0; }
+    fclose(f);
+    for(int i=0;i<source_frames;i++)
+        mono[i]=channels==1 ? source[i] : (int16_t)(((int)source[i*2]+(int)source[i*2+1])/2);
+    free(source); clip->samples=mono; clip->frames=source_frames; return 1;
+}
