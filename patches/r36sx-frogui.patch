+    for(int row=0;row<visible;row++) {
+        size_t end=offset;
+        char shown[128]; int used=0,skip=editor_left_column;
+        while(end<editor_length && editor_text[end]!='\n') end++;
+        size_t p=offset;
+        while(p<end && skip-->0) p++;
+        {
+            size_t visible_start=p;
+            size_t visible_end=end<visible_start+(size_t)columns?end:visible_start+(size_t)columns;
+            size_t highlight_start=selection_start>visible_start?selection_start:visible_start;
+            size_t highlight_end=selection_end<visible_end?selection_end:visible_end;
+            if(highlight_start<highlight_end) {
