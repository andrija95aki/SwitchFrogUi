+static void category_reset(void) {
+    category_entry_count = 0;
+    game_category_count = 0;
+    game_category_index = 0;
+}
+
+static int category_name_compare(const void *a, const void *b) {
+    return strcasecmp((const char *)a, (const char *)b);
+}
+
+static void category_add_name(const char *name) {
+    if (!name || !*name) name = "Unclassified";
+    for (int i = 1; i < game_category_count; i++)
+        if (!strcasecmp(game_categories[i], name)) return;
+    if (game_category_count >= MAX_GAME_CATEGORIES) return;
+    snprintf(game_categories[game_category_count++],
+             sizeof(game_categories[0]), "%s", name);
+}
+
+static void category_load_metadata(const char *platform_path) {
+    char metadata_path[MAX_PATH_LEN];
+    snprintf(metadata_path, sizeof(metadata_path), "%s/.metadata.tsv", platform_path);
+    FILE *file = fopen(metadata_path, "rb");
+    char line[1024];
+    while (file && fgets(line, sizeof(line), file)) {
+        if (line[0] == '#') continue;
+        char *tab1 = strchr(line, '\t'); if (!tab1) continue;
+        *tab1++ = '\0';
+        char *tab2 = strchr(tab1, '\t'); if (tab2) *tab2 = '\0';
+        tab1[strcspn(tab1, "\r\n")] = '\0';
+        if (!*tab1) continue;
+        for (int i = 0; i < entry_count; i++) {
+            const char *base = strrchr(entries[i].name, '/');
+            base = base ? base + 1 : entries[i].name;
+            if (!strcasecmp(base, line)) {
+                snprintf(entries[i].category, sizeof(entries[i].category), "%s", tab1);
+                break;
+            }
+        }
+    }
+    if (file) fclose(file);
+    for (int i = 0; i < entry_count; i++) {
+        if (!entries[i].category[0])
+            snprintf(entries[i].category, sizeof(entries[i].category), "Unclassified");
+        category_add_name(entries[i].category);
+    }
+}
+
+static void category_apply_filter(void) {
+    if (category_entry_count <= 0 || game_category_count <= 0) return;
+    entry_count = 0;
+    for (int i = 0; i < category_entry_count; i++) {
+        if (game_category_index != 0 &&
+            strcasecmp(category_entries[i].category,
+                       game_categories[game_category_index]) != 0) continue;
+        if (entry_count >= entry_capacity) {
+            int next = entry_capacity ? entry_capacity * 2 : INITIAL_ENTRIES_CAPACITY;
+            DirEntry *grown = realloc(entries, (size_t)next * sizeof(*entries));
+            if (!grown) break;
+            entries = grown; entry_capacity = next;
+        }
+        entries[entry_count++] = category_entries[i];
+    }
+    selected_index = 0;
+    scroll_offset = 0;
+    ui_rendered_once = 0;
+}
+
+static void category_prepare(const char *platform_path) {
+    snprintf(game_categories[0], sizeof(game_categories[0]), "ALL");
+    game_category_count = 1;
+    game_category_index = 0;
+    category_load_metadata(platform_path);
+    if (game_category_count > 2)
+        qsort(&game_categories[1], (size_t)(game_category_count - 1),
+              sizeof(game_categories[0]), category_name_compare);
+    DirEntry *copy = realloc(category_entries, (size_t)entry_count * sizeof(*copy));
+    if (!copy && entry_count) { category_reset(); return; }
+    category_entries = copy;
+    if (entry_count) memcpy(category_entries, entries, (size_t)entry_count * sizeof(*entries));
+    category_entry_count = entry_count;
+}
+
+static void category_change(int direction) {
+    if (game_category_count <= 1) return;
+    game_category_index = (game_category_index + direction + game_category_count) % game_category_count;
+    category_apply_filter();
+    char message[96];
+    snprintf(message, sizeof(message), "%s: %d games",
+             game_categories[game_category_index], entry_count);
+    ui_notice(message);
+}
