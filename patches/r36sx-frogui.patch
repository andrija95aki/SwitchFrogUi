+static void render_slider_row(const char *label, const char *value, int position,
+                              int maximum, int y, int selected) {
+    int x=PADDING, w=SCREEN_WIDTH-PADDING*2, h=UI_S(28);
+    uint16_t bg=selected?COLOR_SELECT_BG:ui_mix565(COLOR_BG,COLOR_TEXT,20);
+    uint16_t fg=selected?COLOR_SELECT_TEXT:COLOR_TEXT;
+    if(selected) render_rounded_rect(framebuffer,x-UI_S(2),y-UI_S(2),w+UI_S(4),h+UI_S(4),UI_S(8),COLOR_TEXT);
+    render_rounded_rect(framebuffer,x,y,w,h,UI_S(7),bg);
+    font_draw_text(framebuffer,SCREEN_WIDTH,SCREEN_HEIGHT,x+UI_S(10),y+UI_S(8),label,fg);
+    int value_w=font_measure_text_scaled(value,80);
+    int value_x=x+w-value_w-UI_S(8);
+    int track_x=x+w*52/100, track_w=value_x-track_x-UI_S(9);
+    int track_y=y+h/2-UI_S(2), track_h=UI_S(4);
+    if(track_w<UI_S(30)) track_w=UI_S(30);
+    render_rounded_rect(framebuffer,track_x,track_y,track_w,track_h,track_h/2,COLOR_DISABLED);
+    int fill=maximum>0 ? track_w*position/maximum : 0;
+    if(fill<track_h) fill=track_h;
+    render_rounded_rect(framebuffer,track_x,track_y,fill,track_h,track_h/2,fg);
+    int knob=UI_S(10), kx=track_x+fill-knob/2;
+    if(kx<track_x-knob/2) kx=track_x-knob/2;
+    if(kx>track_x+track_w-knob/2) kx=track_x+track_w-knob/2;
+    render_rounded_rect_aa(framebuffer,kx,y+h/2-knob/2,knob,knob,knob/2,fg);
+    font_draw_text_scaled(framebuffer,SCREEN_WIDTH,SCREEN_HEIGHT,value_x,y+UI_S(9),value,fg,80);
+}
