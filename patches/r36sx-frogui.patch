+/* A deliberately small real Linux terminal.  It runs the card's BusyBox ash
+ * as a persistent child and renders stdin/stdout inside FrogUI, avoiding an X
+ * server or framebuffer ownership fight. */
+#define TERMINAL_LINE_COUNT 48
+#define TERMINAL_LINE_LEN 96
+#define TERMINAL_HISTORY_COUNT 32
+#define TERMINAL_HISTORY_FILE SDCARD_BASE "/frogui/terminal_history.txt"
+static char terminal_lines[TERMINAL_LINE_COUNT][TERMINAL_LINE_LEN];
+static int terminal_line_count;
+static char terminal_input[TERMINAL_LINE_LEN];
+static int terminal_input_len;
+static pid_t terminal_pid = -1;
+static int terminal_in_fd = -1, terminal_out_fd = -1;
+static char terminal_pending_line[TERMINAL_LINE_LEN];
+static int terminal_pending_used, terminal_pending_ansi;
+static char terminal_history[TERMINAL_HISTORY_COUNT][TERMINAL_LINE_LEN];
+static int terminal_history_count, terminal_history_index;
+static char terminal_history_draft[TERMINAL_LINE_LEN];
+
+static void terminal_history_load(void) {
+    FILE *file = fopen(TERMINAL_HISTORY_FILE, "rb");
+    char line[TERMINAL_LINE_LEN];
+    terminal_history_count = 0;
+    if (file) {
+        while (fgets(line, sizeof(line), file)) {
+            line[strcspn(line, "\r\n")] = '\0';
+            if (!line[0]) continue;
+            if (terminal_history_count >= TERMINAL_HISTORY_COUNT) {
+                memmove(terminal_history, terminal_history + 1,
+                        sizeof(terminal_history[0]) * (TERMINAL_HISTORY_COUNT - 1));
+                terminal_history_count = TERMINAL_HISTORY_COUNT - 1;
+            }
+            snprintf(terminal_history[terminal_history_count++], TERMINAL_LINE_LEN, "%s", line);
+        }
+        fclose(file);
+    }
+    terminal_history_index = terminal_history_count;
+    terminal_history_draft[0] = '\0';
+}
+
+static void terminal_history_add(const char *command) {
+    FILE *file;
+    if (!command || !command[0]) return;
+    if (terminal_history_count &&
+        !strcmp(terminal_history[terminal_history_count - 1], command)) {
+        terminal_history_index = terminal_history_count; return;
+    }
+    if (terminal_history_count >= TERMINAL_HISTORY_COUNT) {
+        memmove(terminal_history, terminal_history + 1,
+                sizeof(terminal_history[0]) * (TERMINAL_HISTORY_COUNT - 1));
+        terminal_history_count = TERMINAL_HISTORY_COUNT - 1;
+    }
+    snprintf(terminal_history[terminal_history_count++], TERMINAL_LINE_LEN, "%s", command);
+    terminal_history_index = terminal_history_count;
+    file = fopen(TERMINAL_HISTORY_FILE, "wb");
+    if (file) {
+        for (int i = 0; i < terminal_history_count; i++)
+            fprintf(file, "%s\n", terminal_history[i]);
+        fflush(file); fsync(fileno(file)); fclose(file);
+    }
+}
+
+static void terminal_history_recall(int direction) {
+    if (!terminal_history_count) return;
+    if (direction < 0) {
+        if (terminal_history_index == terminal_history_count)
+            snprintf(terminal_history_draft, sizeof(terminal_history_draft), "%s", terminal_input);
+        if (terminal_history_index > 0) terminal_history_index--;
+        snprintf(terminal_input, sizeof(terminal_input), "%s", terminal_history[terminal_history_index]);
+    } else {
+        if (terminal_history_index < terminal_history_count) terminal_history_index++;
+        if (terminal_history_index == terminal_history_count)
+            snprintf(terminal_input, sizeof(terminal_input), "%s", terminal_history_draft);
+        else
+            snprintf(terminal_input, sizeof(terminal_input), "%s", terminal_history[terminal_history_index]);
+    }
+    terminal_input_len = (int)strlen(terminal_input);
+}
+
+static void terminal_add_line(const char *text) {
+    if (terminal_line_count >= TERMINAL_LINE_COUNT) {
+        memmove(terminal_lines, terminal_lines + 1,
+                sizeof(terminal_lines[0]) * (TERMINAL_LINE_COUNT - 1));
+        terminal_line_count = TERMINAL_LINE_COUNT - 1;
+    }
+    snprintf(terminal_lines[terminal_line_count++], TERMINAL_LINE_LEN, "%s", text ? text : "");
+}
+
+static void terminal_poll_output(void) {
+    char buf[256]; ssize_t got;
+    if (terminal_out_fd < 0) return;
+    while ((got = read(terminal_out_fd, buf, sizeof(buf))) > 0) {
+        for (ssize_t i = 0; i < got; i++) {
+            unsigned char c = (unsigned char)buf[i];
+            if (terminal_pending_ansi) { if ((c >= '@' && c <= '~') && c != '[') terminal_pending_ansi = 0; continue; }
+            if (c == 27) { terminal_pending_ansi = 1; continue; }
+            if (c == '\r') continue;
+            if (c == '\n') {
+                terminal_pending_line[terminal_pending_used] = '\0';
+                terminal_add_line(terminal_pending_line); terminal_pending_used = 0; continue;
+            }
+            if (c >= 32 && c < 127 && terminal_pending_used < TERMINAL_LINE_LEN - 1)
+                terminal_pending_line[terminal_pending_used++] = (char)c;
+        }
+    }
+    if (terminal_pid > 0 && waitpid(terminal_pid, NULL, WNOHANG) == terminal_pid) {
+        terminal_pid = -1; terminal_add_line("[shell exited]");
+    }
+}
+
+static void terminal_start(void) {
+    int input_pipe[2], output_pipe[2];
+    if (terminal_active) return;
+    terminal_line_count = terminal_input_len = 0; terminal_input[0] = '\0';
+    terminal_pending_used = terminal_pending_ansi = 0;
+    if (pipe(input_pipe) || pipe(output_pipe)) { terminal_add_line("Unable to create shell pipes"); return; }
+    terminal_pid = fork();
+    if (terminal_pid == 0) {
+        close(input_pipe[1]); close(output_pipe[0]);
+        dup2(input_pipe[0], STDIN_FILENO); dup2(output_pipe[1], STDOUT_FILENO);
+        dup2(output_pipe[1], STDERR_FILENO);
+        close(input_pipe[0]); close(output_pipe[1]);
+        chdir("/mnt/sdcard");
+        execl("/bin/sh", "sh", (char *)NULL);
+        _exit(127);
+    }
+    close(input_pipe[0]); close(output_pipe[1]);
+    terminal_in_fd = input_pipe[1]; terminal_out_fd = output_pipe[0];
+    fcntl(terminal_out_fd, F_SETFL, fcntl(terminal_out_fd, F_GETFL, 0) | O_NONBLOCK);
+    terminal_active = true;
+    ui_notice_frames = 0; ui_notice_text[0] = '\0';
+    io_keyboard_test_start();
+    terminal_history_load();
+    editor_keyboard_drain();
+    virtual_keyboard_prepare();
+}
+
+static void terminal_stop(void) {
+    if (terminal_in_fd >= 0) { write(terminal_in_fd, "exit\n", 5); close(terminal_in_fd); }
+    if (terminal_out_fd >= 0) close(terminal_out_fd);
+    terminal_in_fd = terminal_out_fd = -1;
+    if (terminal_pid > 0) {
+        if (waitpid(terminal_pid, NULL, WNOHANG) == 0) kill(terminal_pid, SIGTERM);
+        waitpid(terminal_pid, NULL, WNOHANG);
+    }
+    terminal_pid = -1; terminal_active = false;
+    io_keyboard_test_stop();
+}
+
+static void terminal_submit(void) {
+    char shown[TERMINAL_LINE_LEN];
+    snprintf(shown, sizeof(shown), "$ %s", terminal_input); terminal_add_line(shown);
+    terminal_history_add(terminal_input);
+    if (terminal_in_fd >= 0) { write(terminal_in_fd, terminal_input, terminal_input_len); write(terminal_in_fd, "\n", 1); }
+    terminal_input_len = 0; terminal_input[0] = '\0';
+}
+
+static void terminal_handle_keyboard(void) {
+    int code, value;
+    io_keyboard_test_poll(); terminal_poll_output();
+    while (io_keyboard_pop_event(&code, &value)) {
+        int ch;
+        if (!value) continue;
+        if (code == KEY_UP) terminal_history_recall(-1);
+        else if (code == KEY_DOWN) terminal_history_recall(1);
+        else if (code == KEY_ENTER || code == KEY_KPENTER) terminal_submit();
+        else if (code == KEY_BACKSPACE && terminal_input_len > 0) terminal_input[--terminal_input_len] = '\0';
+        else if (code != KEY_ESC && (ch = io_keyboard_key_to_ascii(code, io_keyboard_shift_held())) != 0 &&
+                 terminal_input_len < TERMINAL_LINE_LEN - 1) {
+            terminal_input[terminal_input_len++] = (char)ch; terminal_input[terminal_input_len] = '\0';
+        }
+    }
+}
+
+static void file_name_finish(void) {
+    if (!editor_name_valid(file_name_text)) { ui_notice("Invalid name"); return; }
+    file_name_prompt_active = false;
+    file_open_confirmation(file_name_action);
+}
+
+static void file_name_insert(int ch) {
+    if (ch < 32 || file_name_len >= (int)sizeof(file_name_text) - 1) return;
+    if (ch == '/' || ch == '\\') return;
+    memmove(file_name_text + file_name_cursor + 1, file_name_text + file_name_cursor,
+            (size_t)(file_name_len - file_name_cursor + 1));
+    file_name_text[file_name_cursor++] = (char)ch; file_name_len++;
+}
+
+static void file_name_backspace(void) {
+    if (file_name_cursor <= 0) return;
+    memmove(file_name_text + file_name_cursor - 1, file_name_text + file_name_cursor,
+            (size_t)(file_name_len - file_name_cursor + 1));
+    file_name_cursor--; file_name_len--;
+}
+
+static void file_handle_name_prompt(void) {
+    int code, value, ch, action;
+    ui_rendered_once = 0;
+    io_keyboard_test_poll();
+    virtual_keyboard_sync();
+    while (io_keyboard_pop_event(&code, &value)) {
+        if (!value) continue;
+        if (code == KEY_ENTER || code == KEY_KPENTER) { file_name_finish(); return; }
+        if (code == KEY_ESC) { file_name_prompt_active = false; return; }
+        if (code == KEY_LEFT && file_name_cursor > 0) file_name_cursor--;
+        else if (code == KEY_RIGHT && file_name_cursor < file_name_len) file_name_cursor++;
+        else if (code == KEY_HOME) file_name_cursor = 0;
+        else if (code == KEY_END) file_name_cursor = file_name_len;
+        else if (code == KEY_BACKSPACE) file_name_backspace();
+        else if (code == KEY_DELETE && file_name_cursor < file_name_len) {
+            memmove(file_name_text + file_name_cursor, file_name_text + file_name_cursor + 1,
+                    (size_t)(file_name_len - file_name_cursor)); file_name_len--;
+        } else if (!io_keyboard_ctrl_held() &&
+                   (ch = io_keyboard_key_to_ascii(code, io_keyboard_shift_held())) >= 32)
+            file_name_insert(ch);
+    }
+    if (input_was_pressed(FROG_BTN_B)) { file_name_prompt_active = false; return; }
+    if (input_was_pressed(FROG_BTN_SELECT)) { virtual_keyboard_toggle(); return; }
+    action = virtual_keyboard_handle_input(&file_name_kbd_r, &file_name_kbd_c);
+    if (action == VK_ACTION_BACKSPACE) file_name_backspace();
+    else if (action == VK_ACTION_ENTER) file_name_finish();
+    else if (action >= 32 && action < 127) file_name_insert(action);
+}
+
+static void file_handle_action_menu(void) {
+    if (input_was_pressed(FROG_BTN_B)) { file_action_menu_active = false; return; }
+    if (input_was_pressed(FROG_BTN_UP)) file_action_menu_index = (file_action_menu_index - 1 + FILE_ACTION_COUNT) % FILE_ACTION_COUNT;
+    if (input_was_pressed(FROG_BTN_DOWN)) file_action_menu_index = (file_action_menu_index + 1) % FILE_ACTION_COUNT;
+    if (!input_was_pressed(FROG_BTN_A)) return;
+    if (file_action_menu_index == FILE_ACTION_CANCEL) { file_action_menu_active = false; return; }
+    if ((file_action_menu_index == FILE_ACTION_COPY || file_action_menu_index == FILE_ACTION_CUT ||
+         file_action_menu_index == FILE_ACTION_RENAME || file_action_menu_index == FILE_ACTION_DELETE) &&
+        file_action_count <= 0) { ui_notice("No file selected"); return; }
+    if (file_action_menu_index == FILE_ACTION_RENAME && file_action_count != 1) {
+        ui_notice("Select one item to rename"); return;
+    }
+    if ((file_action_menu_index == FILE_ACTION_PASTE || file_action_menu_index == FILE_ACTION_CLEAR) &&
+        !file_clipboard_active) { ui_notice("Clipboard is empty"); return; }
+    if (file_action_menu_index == FILE_ACTION_COPY ||
+        file_action_menu_index == FILE_ACTION_CUT ||
+        file_action_menu_index == FILE_ACTION_RENAME ||
+        file_action_menu_index == FILE_ACTION_DELETE) {
+        for (int i = 0; i < file_action_count; i++) {
+            int lock = directory_lock_related_index(file_action_items[i].path);
+            if (lock >= 0) {
+                file_action_menu_active = false;
+                directory_lock_prompt_open(locked_directories[lock]);
+                return;
+            }
+        }
+    }
+    if (file_action_menu_index == FILE_ACTION_RENAME || file_action_menu_index == FILE_ACTION_NEW_FOLDER)
+        file_begin_name_prompt(file_action_menu_index);
+    else file_open_confirmation(file_action_menu_index);
+}
+
+static void directory_lock_handle_prompt(void) {
+    static const FrogButton sequence[] = {
+        FROG_BTN_UP, FROG_BTN_UP, FROG_BTN_DOWN, FROG_BTN_DOWN,
+        FROG_BTN_LEFT, FROG_BTN_RIGHT, FROG_BTN_LEFT, FROG_BTN_RIGHT
+    };
+    if (input_was_pressed(FROG_BTN_B)) {
+        directory_lock_prompt_active = false;
+        directory_lock_sequence_index = 0;
+        ui_rendered_once = 0;
+        return;
+    }
+
+    FrogButton pressed = FROG_BTN_COUNT;
+    if (input_was_pressed(FROG_BTN_UP)) pressed = FROG_BTN_UP;
+    else if (input_was_pressed(FROG_BTN_DOWN)) pressed = FROG_BTN_DOWN;
+    else if (input_was_pressed(FROG_BTN_LEFT)) pressed = FROG_BTN_LEFT;
+    else if (input_was_pressed(FROG_BTN_RIGHT)) pressed = FROG_BTN_RIGHT;
+    if (pressed == FROG_BTN_COUNT) return;
+
+    if (pressed == sequence[directory_lock_sequence_index])
+        directory_lock_sequence_index++;
+    else
+        directory_lock_sequence_index = pressed == FROG_BTN_UP ? 1 : 0;
+    ui_rendered_once = 0;
+
+    if (directory_lock_sequence_index == (int)(sizeof(sequence) / sizeof(sequence[0]))) {
+        char unlocked[MAX_PATH_LEN];
+        snprintf(unlocked, sizeof(unlocked), "%s", directory_lock_prompt_path);
+        int index = directory_lock_exact_index(unlocked);
+        if (directory_lock_remove_index(index)) {
+            const char *name = strrchr(unlocked, '/');
+            directory_lock_prompt_active = false;
+            directory_lock_sequence_index = 0;
+            scan_directory(current_path);
+            if (name && name[1]) browser_select_name(name + 1);
+            ui_notice("Directory unlocked");
+        } else {
+            directory_lock_sequence_index = 0;
+            ui_notice("Could not save unlock state");
+        }
+    }
+}
+
+static void core_picker_open_game(const char *path, bool return_to_details) {
+    if (!path || !*path) return;
+    strncpy(core_picker_key, path, sizeof(core_picker_key) - 1);
+    core_picker_key[sizeof(core_picker_key) - 1] = '\0';
+    const char *base = strrchr(path, '/');
+    base = base ? base + 1 : path;
+    snprintf(core_picker_title, sizeof(core_picker_title), "Game: %s", base);
+    core_picker_idx = core_choice_index_for_path(core_override_lookup(path, NULL));
+    core_picker_scroll = 0;
+    if (core_picker_idx >= VISIBLE_ENTRIES)
+        core_picker_scroll = core_picker_idx - VISIBLE_ENTRIES + 1;
+    core_picker_return_to_details = return_to_details;
+    if (return_to_details) game_details_active = false;
+    core_picker_active = true;
+    ui_rendered_once = 0;
+}
+
+static void handle_input(void) {
+    input_update();
+
+    if (directory_lock_prompt_active) {
+        directory_lock_handle_prompt();
+        return;
+    }
+
+    if (photo_viewer_active) {
+        if (input_was_pressed(FROG_BTN_B)) {
+            photo_viewer_close();
+            ui_rendered_once = 0;
+        } else if (input_was_pressed(FROG_BTN_L1)) {
+            photo_rotation = (photo_rotation + 3) & 3;
+            photo_pan_x = photo_pan_y = 0;
+            ui_rendered_once = 0;
+        } else if (input_was_pressed(FROG_BTN_R1)) {
+            photo_rotation = (photo_rotation + 1) & 3;
+            photo_pan_x = photo_pan_y = 0;
+            ui_rendered_once = 0;
+        } else if (input_was_pressed(FROG_BTN_A)) {
+            if (photo_zoom_index < (int)(sizeof(photo_zoom_levels) / sizeof(photo_zoom_levels[0])) - 1)
+                photo_zoom_index++;
+            photo_viewer_clamp_pan();
+            ui_rendered_once = 0;
+        } else if (input_was_pressed(FROG_BTN_Y)) {
+            if (photo_zoom_index > 0) photo_zoom_index--;
+            if (photo_zoom_index == 0) photo_pan_x = photo_pan_y = 0;
+            photo_viewer_clamp_pan();
+            ui_rendered_once = 0;
+        } else if (input_was_pressed(FROG_BTN_X)) {
+            photo_zoom_index = 0;
+            photo_pan_x = photo_pan_y = 0;
+            ui_rendered_once = 0;
+        } else if (photo_zoom_index == 0 && input_was_pressed(FROG_BTN_LEFT)) {
+            photo_viewer_step(-1);
+        } else if (photo_zoom_index == 0 && input_was_pressed(FROG_BTN_RIGHT)) {
+            photo_viewer_step(1);
+        } else if (photo_zoom_index > 0) {
+            int step = UI_S(36);
+            if (input_was_pressed(FROG_BTN_LEFT))  photo_pan_x -= step;
+            if (input_was_pressed(FROG_BTN_RIGHT)) photo_pan_x += step;
+            if (input_was_pressed(FROG_BTN_UP))    photo_pan_y -= step;
+            if (input_was_pressed(FROG_BTN_DOWN))  photo_pan_y += step;
+            photo_viewer_clamp_pan();
+            ui_rendered_once = 0;
+        }
+        return;
+    }
+
+    if (terminal_active) {
+        int action;
+        terminal_handle_keyboard();
+        virtual_keyboard_sync();
+        if (input_was_pressed(FROG_BTN_SELECT)) {
+            virtual_keyboard_toggle();
+            return;
+        }
+        if (input_was_pressed(FROG_BTN_B)) {
+            if (virtual_keyboard_visible) {
+                virtual_keyboard_visible = false;
+                virtual_keyboard_manual = true;
+                ui_rendered_once = 0;
+                return;
+            }
+            terminal_stop();
+            return_to_home();
+            return;
+        }
+        action = virtual_keyboard_handle_input(&virtual_keyboard_r, &virtual_keyboard_c);
+        if (action == VK_ACTION_BACKSPACE && terminal_input_len > 0)
+            terminal_input[--terminal_input_len] = '\0';
+        else if (action == VK_ACTION_ENTER) terminal_submit();
+        else if (action >= 32 && action < 127 && terminal_input_len < TERMINAL_LINE_LEN - 1) {
+            terminal_input[terminal_input_len++] = (char)action;
+            terminal_input[terminal_input_len] = '\0';
+        }
+        ui_rendered_once = 0;
+        return;
+    }
+
+    if (editor_prompt_active) {
+        int action;
+        editor_handle_prompt_keyboard();
+        virtual_keyboard_sync();
+        if (!editor_prompt_active) return;
+        if (input_was_pressed(FROG_BTN_B)) { editor_prompt_active = false; return; }
+        if (input_was_pressed(FROG_BTN_SELECT)) { virtual_keyboard_toggle(); return; }
+        action = virtual_keyboard_handle_input(&virtual_keyboard_r, &virtual_keyboard_c);
+        if (action == VK_ACTION_ENTER) editor_finish_prompt();
+        else if (action == VK_ACTION_BACKSPACE && editor_prompt_cursor > 0) {
+            memmove(editor_prompt_text + editor_prompt_cursor - 1,
+                    editor_prompt_text + editor_prompt_cursor,
+                    (size_t)(editor_prompt_len - editor_prompt_cursor + 1));
+            editor_prompt_cursor--; editor_prompt_len--;
+        } else if (action >= 32 && action < 127 && editor_prompt_len < EDITOR_NAME_CAP - 1) {
+            memmove(editor_prompt_text + editor_prompt_cursor + 1,
+                    editor_prompt_text + editor_prompt_cursor,
+                    (size_t)(editor_prompt_len - editor_prompt_cursor + 1));
+            editor_prompt_text[editor_prompt_cursor++] = (char)action;
+            editor_prompt_len++;
+        }
+        ui_rendered_once = 0;
+        return;
+    }
+
+    if (text_editor_active) {
+        int action;
+        editor_handle_keyboard();
+        virtual_keyboard_sync();
+        if (editor_prompt_active) return;
+        if (input_was_pressed(FROG_BTN_SELECT)) { virtual_keyboard_toggle(); return; }
+        if (!editor_prompt_active && input_was_pressed(FROG_BTN_B)) {
+            if (virtual_keyboard_visible) {
+                virtual_keyboard_visible = false;
+                virtual_keyboard_manual = true;
+                ui_rendered_once = 0;
+                return;
+            }
+            if (editor_dirty) editor_save();
+            text_editor_active = false;
+            scan_directory(current_path);
+            editor_keyboard_drain();
+            return;
+        }
+        action = virtual_keyboard_handle_input(&virtual_keyboard_r, &virtual_keyboard_c);
+        if (action == VK_ACTION_ENTER) editor_insert_char('\n');
+        else if (action == VK_ACTION_BACKSPACE) {
+            if (!editor_has_selection() && editor_cursor > 0) {
+                editor_selection_anchor = editor_cursor;
+                editor_cursor--;
+            }
+            if (editor_has_selection()) editor_replace_selection(NULL, 0);
+        } else if (action >= 32 && action < 127) editor_insert_char((char)action);
+        editor_cursor_view_update();
+        ui_rendered_once = 0;
+        return;
+    }
+
+    if (keyboard_mapping_active) {
+        if (keyboard_mapping_capture) {
+            int code;
+            if (io_keyboard_capture_poll(&code)) {
+                io_keyboard_mapping_set_code(keyboard_mapping_idx,code);
+                io_keyboard_mapping_save(); keyboard_mapping_capture=false;
+                ui_notice("Keyboard mapping saved"); ui_rendered_once=0;
+            }
+            return;
+        }
+        io_keyboard_test_poll();
+        if (input_was_pressed(FROG_BTN_UP)) keyboard_mapping_idx=(keyboard_mapping_idx-1+IO_KEYBOARD_MAPPING_COUNT)%IO_KEYBOARD_MAPPING_COUNT;
+        if (input_was_pressed(FROG_BTN_DOWN)) keyboard_mapping_idx=(keyboard_mapping_idx+1)%IO_KEYBOARD_MAPPING_COUNT;
+        if (input_was_pressed(FROG_BTN_A)) { keyboard_mapping_capture=true; io_keyboard_capture_arm(); }
+        if (input_was_pressed(FROG_BTN_X)) {
+            io_keyboard_mapping_reset_defaults(); io_keyboard_mapping_save(); ui_notice("Keyboard defaults restored");
+        }
+        if (input_was_pressed(FROG_BTN_B)) {
+            io_keyboard_test_stop(); keyboard_mapping_active=false; settings_menu_active=true;
+        }
+        return;
+    }
+
+    /* The first press after a timeout only restores the backlight. It must not
+     * also launch a game or move the selection underneath a black screen. */
+    if (screen_blanked) {
+        if (any_button_was_pressed()) {
+            screen_blanked = false;
+            screen_woke_this_frame = true;
+            screen_idle_frames = 0;
+            screen_blanked_frames = 0;
+            cube_set_backlight(settings_brightness);
+            ui_rendered_once = 0;
+        }
+        return;
+    }
+
+    if (file_name_prompt_active) { file_handle_name_prompt(); return; }
+    if (file_confirm_active) {
+        if (file_pending_action == FILE_ACTION_PASTE &&
+            (input_was_pressed(FROG_BTN_LEFT) || input_was_pressed(FROG_BTN_RIGHT))) {
+            int delta = input_was_pressed(FROG_BTN_RIGHT) ? 1 : -1;
+            file_collision_policy = (file_collision_policy + delta +
+                                     FILE_COLLISION_COUNT) % FILE_COLLISION_COUNT;
+            ui_rendered_once = 0;
+            return;
+        }
+        if (input_was_pressed(FROG_BTN_A)) file_execute_pending();
+        else if (input_was_pressed(FROG_BTN_B)) { file_confirm_active = false; file_pending_action = FILE_ACTION_CANCEL; }
+        return;
+    }
+    if (file_action_menu_active) { file_handle_action_menu(); return; }
+
+    if (page_jump_active) {
+        page_jump_handle_input();
+        return;
+    }
+
+    /* Full-screen game information panel. The emulator picker is explicit here
+     * so it is discoverable and works from grids, search and favourites. */
+    if (game_details_active) {
+        if (input_was_pressed(FROG_BTN_A))
+            launch_game_path(game_details_path);
+        if (input_was_pressed(FROG_BTN_X)) {
+            core_picker_open_game(game_details_path, true);
+            return;
+        }
+        if (input_was_pressed(FROG_BTN_B)) {
+            game_details_active = false;
+            ui_rendered_once = 0;
+        }
+        return;
+    }
+
+    /* Search keyboard overlay */
+    if (search_kbd_active) {
+        int code, value, ch;
+        io_keyboard_test_poll();
+        virtual_keyboard_sync();
+        while (io_keyboard_pop_event(&code, &value)) {
+            int len = (int)strlen(search_query);
+            if (!value) continue;
+            if (code == KEY_ENTER || code == KEY_KPENTER) { run_search(); return; }
+            if (code == KEY_ESC) {
+                search_kbd_active = false;
+                io_keyboard_test_stop();
+                scan_directory(current_path);
+                selected_index = 0; scroll_offset = 0;
+                return;
+            }
+            if (code == KEY_BACKSPACE || code == KEY_DELETE) {
+                if (len > 0) search_query[len - 1] = '\0';
+            } else if (!io_keyboard_ctrl_held() &&
+                       (ch = io_keyboard_key_to_ascii(code, io_keyboard_shift_held())) >= 32 &&
+                       len < (int)sizeof(search_query) - 1) {
+                search_query[len] = (char)ch;
+                search_query[len + 1] = '\0';
+            }
+        }
+        if (input_was_pressed(FROG_BTN_SELECT)) { virtual_keyboard_toggle(); return; }
+        if (!virtual_keyboard_visible) {
+            if (input_was_pressed(FROG_BTN_B)) {
+                search_kbd_active = false;
+                io_keyboard_test_stop();
+                scan_directory(current_path);
+                selected_index = 0; scroll_offset = 0;
+            }
+            return;
+        }
+        if (input_was_pressed(FROG_BTN_UP))    search_kbd_r = (search_kbd_r - 1 + KBD_NROWS) % KBD_NROWS;
+        if (input_was_pressed(FROG_BTN_DOWN))  search_kbd_r = (search_kbd_r + 1) % KBD_NROWS;
+        if (input_was_pressed(FROG_BTN_LEFT))  search_kbd_c--;
+        if (input_was_pressed(FROG_BTN_RIGHT)) search_kbd_c++;
+        { int rl = kbd_row_len(search_kbd_r);
+          if (search_kbd_c < 0) search_kbd_c = rl - 1;
+          if (search_kbd_c >= rl) search_kbd_c = 0; }
+        if (input_was_pressed(FROG_BTN_A)) {
+            int len = (int)strlen(search_query);
+            if (search_kbd_r == KBD_SPECIAL_ROW) {
