+static void directory_locks_load(void) {
+    locked_directory_count = 0;
+    FILE *file = fopen(DIRECTORY_LOCK_FILE, "rb");
+    char line[MAX_PATH_LEN];
+    while (file && locked_directory_count < MAX_LOCKED_DIRECTORIES &&
+           fgets(line, sizeof(line), file)) {
+        directory_lock_normalize(line);
+        if (!directory_lock_valid_path(line)) continue;
+        int duplicate = 0;
+        for (int i = 0; i < locked_directory_count; i++)
+            if (!strcmp(locked_directories[i], line)) { duplicate = 1; break; }
+        if (!duplicate)
+            snprintf(locked_directories[locked_directory_count++], MAX_PATH_LEN,
+                     "%s", line);
+    }
+    if (file) fclose(file);
+}
+
+static int directory_locks_save(void) {
+    FILE *file = fopen(DIRECTORY_LOCK_TMP, "wb");
+    if (!file) return 0;
+    int ok = 1;
+    for (int i = 0; i < locked_directory_count; i++)
+        if (fprintf(file, "%s\n", locked_directories[i]) < 0) { ok = 0; break; }
+    if (ok && (fflush(file) != 0 || fsync(fileno(file)) != 0)) ok = 0;
+    if (fclose(file) != 0) ok = 0;
+    if (!ok || rename(DIRECTORY_LOCK_TMP, DIRECTORY_LOCK_FILE) != 0) {
+        unlink(DIRECTORY_LOCK_TMP);
+        return 0;
+    }
+    return 1;
+}
+
+static int directory_lock_exact_index(const char *path) {
+    if (!path) return -1;
+    for (int i = 0; i < locked_directory_count; i++)
+        if (!strcmp(locked_directories[i], path)) return i;
+    return -1;
+}
+
+/* Return the lock that owns path, including when path is below a locked dir. */
+static int directory_lock_index_for_path(const char *path) {
+    if (!path) return -1;
+    for (int i = 0; i < locked_directory_count; i++) {
+        size_t length = strlen(locked_directories[i]);
+        if (!strncmp(path, locked_directories[i], length) &&
+            (path[length] == '\0' || path[length] == '/')) return i;
+    }
+    return -1;
+}
+
+/* Mutating a parent of a locked directory would silently invalidate its
+ * registry path, so file operations treat ancestors as protected too. */
+static int directory_lock_related_index(const char *path) {
+    int owner = directory_lock_index_for_path(path);
+    if (owner >= 0) return owner;
+    if (!path) return -1;
+    size_t length = strlen(path);
+    for (int i = 0; i < locked_directory_count; i++)
+        if (!strncmp(locked_directories[i], path, length) &&
+            locked_directories[i][length] == '/') return i;
+    return -1;
+}
+
+#ifndef FAT_IOCTL_GET_ATTRIBUTES
+#define FAT_IOCTL_GET_ATTRIBUTES _IOR('r', 0x10, uint32_t)
+#define FAT_IOCTL_SET_ATTRIBUTES _IOW('r', 0x11, uint32_t)
+#endif
+#define SWITCHFROG_FAT_ATTR_HIDDEN 0x02u
+
+static int directory_lock_set_hidden(const char *path, int hidden) {
+    int fd = open(path, O_RDONLY);
+    uint32_t attributes = 0;
+    if (fd < 0) return 0;
+    int ok = ioctl(fd, FAT_IOCTL_GET_ATTRIBUTES, &attributes) == 0;
+    if (ok) {
+        if (hidden) attributes |= SWITCHFROG_FAT_ATTR_HIDDEN;
+        else attributes &= ~SWITCHFROG_FAT_ATTR_HIDDEN;
+        ok = ioctl(fd, FAT_IOCTL_SET_ATTRIBUTES, &attributes) == 0;
+    }
+    close(fd);
+    return ok;
+}
+
+static int directory_lock_add(const char *path, int *hidden_applied) {
+    char normalized[MAX_PATH_LEN];
+    if (hidden_applied) *hidden_applied = 0;
+    if (!path || snprintf(normalized, sizeof(normalized), "%s", path) >=
+                 (int)sizeof(normalized)) return 0;
+    directory_lock_normalize(normalized);
+    if (!directory_lock_valid_path(normalized)) return 0;
+    if (directory_lock_exact_index(normalized) >= 0) return 1;
+    if (locked_directory_count >= MAX_LOCKED_DIRECTORIES) return 0;
+    snprintf(locked_directories[locked_directory_count++], MAX_PATH_LEN,
+             "%s", normalized);
+    if (!directory_locks_save()) {
+        locked_directory_count--;
+        return 0;
+    }
+    if (hidden_applied)
+        *hidden_applied = directory_lock_set_hidden(normalized, 1);
+    return 1;
+}
+
+static int directory_lock_remove_index(int index) {
+    char removed[MAX_PATH_LEN];
+    if (index < 0 || index >= locked_directory_count) return 0;
+    snprintf(removed, sizeof(removed), "%s", locked_directories[index]);
+    memmove(&locked_directories[index], &locked_directories[index + 1],
+            (size_t)(locked_directory_count - index - 1) * sizeof(locked_directories[0]));
+    locked_directory_count--;
+    if (!directory_locks_save()) {
+        memmove(&locked_directories[index + 1], &locked_directories[index],
+                (size_t)(locked_directory_count - index) * sizeof(locked_directories[0]));
+        snprintf(locked_directories[index], MAX_PATH_LEN, "%s", removed);
+        locked_directory_count++;
+        return 0;
+    }
+    (void)directory_lock_set_hidden(removed, 0);
+    return 1;
+}
