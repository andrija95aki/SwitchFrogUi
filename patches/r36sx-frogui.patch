+    while (scale > 52 && font_measure_text_scaled(label, scale) > w - UI_S(16))
+        scale -= 2;
+    int tw = font_measure_text_scaled(label, scale);
+    font_draw_text_scaled(framebuffer, SCREEN_WIDTH, SCREEN_HEIGHT,
+                          x + (w - tw) / 2, by + UI_S(6), label, 0xFFFF, scale);
+}
 
