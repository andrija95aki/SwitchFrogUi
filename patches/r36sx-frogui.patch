+static uint16_t launcher_tile_color(const char *name, int index) {
+    if (!strcmp(name, MUSIC_ENTRY_NAME))      return 0xE94D; /* coral */
+    if (!strcmp(name, VIDEOS_ENTRY_NAME))     return 0xA13F; /* violet */
+    if (!strcmp(name, FILES_ENTRY_NAME))      return 0x35D3; /* cyan */
+    if (!strcmp(name, SETTINGS_ENTRY_NAME))   return 0x7BEF; /* grey */
+    if (!strcmp(name, RECENTS_ENTRY_NAME))    return 0xFD20; /* orange */
+    if (!strcmp(name, FAVOURITES_ENTRY_NAME)) return 0xD96C; /* pink */
+    static const uint16_t system_colors[] = { 0x2D7F, 0x5D39, 0x7C5F, 0x3D8E, 0x9CDA };
+    return system_colors[index % 5];
+}
