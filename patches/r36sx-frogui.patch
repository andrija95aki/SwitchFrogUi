+static void editor_cursor_view_update(void) {
+    int line = 0, column = 0;
+    int visible_lines = (SCREEN_HEIGHT - UI_S(104)) / font_mono_line_height(95);
+    int visible_columns = (SCREEN_WIDTH - PADDING * 2) / font_mono_char_width(95);
+    for (size_t i = 0; i < editor_cursor; i++) {
+        if (editor_text[i] == '\n') { line++; column = 0; }
+        else column++;
+    }
+    if (line < editor_top_line) editor_top_line = line;
+    if (line >= editor_top_line + visible_lines) editor_top_line = line - visible_lines + 1;
+    if (column < editor_left_column) editor_left_column = column;
+    if (column >= editor_left_column + visible_columns) editor_left_column = column - visible_columns + 1;
+    if (editor_top_line < 0) editor_top_line = 0;
+    if (editor_left_column < 0) editor_left_column = 0;
+}
