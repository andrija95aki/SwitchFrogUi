+static void browser_history_push(void) {
+    if (!(viewing_files || viewing_videos || viewing_ebooks || viewing_editor || viewing_jsdev) ||
+        selected_index < 0 || selected_index >= entry_count ||
+        !entries[selected_index].is_dir)
+        return;
+    if (browser_history_depth >= BROWSER_HISTORY_MAX) {
+        memmove(&browser_history[0], &browser_history[1],
+                (BROWSER_HISTORY_MAX - 1) * sizeof(browser_history[0]));
+        browser_history_depth = BROWSER_HISTORY_MAX - 1;
+    }
+    BrowserHistoryEntry *item = &browser_history[browser_history_depth++];
+    strncpy(item->parent_path, current_path, sizeof(item->parent_path) - 1);
+    item->parent_path[sizeof(item->parent_path) - 1] = '\0';
+    strncpy(item->child_name, entries[selected_index].name,
+            sizeof(item->child_name) - 1);
+    item->child_name[sizeof(item->child_name) - 1] = '\0';
+    item->scroll_offset = scroll_offset;
+}
+
+static bool browser_select_name(const char *name) {
+    if (!name || !name[0]) return false;
+    for (int i = 0; i < entry_count; i++) {
+        if (!strcmp(entries[i].name, name)) {
+            selected_index = i;
+            if (selected_index < scroll_offset)
+                scroll_offset = selected_index;
+            else if (selected_index >= scroll_offset + VISIBLE_ENTRIES)
+                scroll_offset = selected_index - VISIBLE_ENTRIES + 1;
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool browser_history_pop(const char *parent_path, const char *child_name) {
+    if (browser_history_depth <= 0) return false;
+    BrowserHistoryEntry *item = &browser_history[browser_history_depth - 1];
+    if (strcmp(item->parent_path, parent_path) ||
+        strcmp(item->child_name, child_name)) {
+        browser_history_clear();
+        return false;
+    }
+    browser_history_depth--;
+    if (!browser_select_name(item->child_name)) return false;
+    int max_scroll = entry_count > VISIBLE_ENTRIES ? entry_count - VISIBLE_ENTRIES : 0;
+    scroll_offset = item->scroll_offset;
+    if (scroll_offset < 0) scroll_offset = 0;
+    if (scroll_offset > max_scroll) scroll_offset = max_scroll;
+    if (selected_index < scroll_offset) scroll_offset = selected_index;
+    if (selected_index >= scroll_offset + VISIBLE_ENTRIES)
+        scroll_offset = selected_index - VISIBLE_ENTRIES + 1;
+    return true;
+}
