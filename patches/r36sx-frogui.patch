+#define POWER_EVENT_FDS 8
+static int power_event_fds[POWER_EVENT_FDS] = {-1,-1,-1,-1,-1,-1,-1,-1};
+static unsigned power_helper_serial;
+
+#define POWER_HELPER_EVENT "/tmp/frogui_power_event"
+
+static unsigned read_power_helper_serial(void) {
+    FILE *f = fopen(POWER_HELPER_EVENT, "r");
+    unsigned serial = 0;
+    if (f) {
+        (void)fscanf(f, "%u", &serial);
+        fclose(f);
+    }
+    return serial;
+}
+
+void power_button_init(void) {
+    char path[32];
+    int opened=0;
+    for (int i=0;i<POWER_EVENT_FDS;i++) {
+        if (power_event_fds[i]>=0) continue;
+        snprintf(path,sizeof(path),"/dev/input/event%d",i);
+        power_event_fds[i]=open(path,O_RDONLY|O_NONBLOCK);
+        if(power_event_fds[i]>=0) opened++;
+    }
+    power_helper_serial = read_power_helper_serial();
+    fprintf(stderr,"FROGUI_DBG: power input: %d event devices opened\n",opened);
+}
+
+void power_button_deinit(void) {
+    for (int i=0;i<POWER_EVENT_FDS;i++) {
+        if(power_event_fds[i]>=0) close(power_event_fds[i]);
+        power_event_fds[i]=-1;
+    }
+}
+
+int power_button_poll(void) {
+    struct input_event event;
+    int pressed=0;
+    for(int i=0;i<POWER_EVENT_FDS;i++) {
+        if(power_event_fds[i]<0) continue;
+        while(read(power_event_fds[i],&event,sizeof(event))==(ssize_t)sizeof(event)) {
+            if(event.type==EV_KEY && event.value==1 &&
+               (event.code==KEY_POWER || event.code==KEY_SLEEP)) pressed=1;
+        }
+    }
+    /* H.OS 1.2 on R36SX exposes no /dev/input/event* nodes to FrogUI.  The
+     * nosleep watcher receives cubevol's GPIO-decoded short tap instead. */
+    unsigned serial = read_power_helper_serial();
+    if (serial == 0) {
+        /* The watcher unlinks the file when it restarts; reset here so its
+         * first new serial (normally 1) cannot equal a stale old value. */
+        power_helper_serial = 0;
+    } else if (serial != power_helper_serial) {
+        power_helper_serial = serial;
+        pressed = 1;
+    }
+    return pressed;
+}
+
+int cube_suspend_to_ram(void) {
+    sync();
+    int fd=open("/sys/power/state",O_WRONLY);
+    if(fd<0) return -1;
+    ssize_t written=write(fd,"mem",3);
     close(fd);
+    return written==3 ? 0 : -1;
 }
 
