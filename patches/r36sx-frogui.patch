+/* Directory locks are a SwitchFrogUI navigation/privacy feature. The registry
+ * is authoritative; the FAT Hidden bit is best-effort because non-Windows
+ * hosts may choose to show DOS-hidden entries. Paths are never renamed. */
+static void directory_lock_normalize(char *path) {
+    size_t length;
+    if (!path) return;
+    path[strcspn(path, "\r\n")] = '\0';
+    length = strlen(path);
+    while (length > strlen(SDCARD_BASE) && path[length - 1] == '/')
+        path[--length] = '\0';
+}
+
+static int directory_lock_valid_path(const char *path) {
+    size_t root = strlen(SDCARD_BASE);
+    return path && !strncmp(path, SDCARD_BASE, root) && path[root] == '/' &&
+           path[root + 1] && !strstr(path, "/../") && !strchr(path, '\n') &&
+           !strchr(path, '\r');
+}
