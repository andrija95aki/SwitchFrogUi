+static void editor_snapshot_free(EditorSnapshot *snapshot) {
+    if (!snapshot) return;
+    free(snapshot->text); memset(snapshot, 0, sizeof(*snapshot));
+}
+
+static void editor_history_clear_stack(EditorSnapshot *stack, int *count) {
+    for (int i = 0; i < *count; i++) editor_snapshot_free(&stack[i]);
+    *count = 0;
+}
+
+static int editor_history_push(EditorSnapshot *stack, int *count) {
+    EditorSnapshot *snapshot;
+    if (*count >= EDITOR_HISTORY_DEPTH) {
+        editor_snapshot_free(&stack[0]);
+        memmove(stack, stack + 1, sizeof(stack[0]) * (EDITOR_HISTORY_DEPTH - 1));
+        (*count)--;
+    }
+    snapshot = &stack[(*count)++];
+    memset(snapshot, 0, sizeof(*snapshot));
+    snapshot->text = (char *)malloc(editor_length + 1);
+    if (!snapshot->text) { (*count)--; return 0; }
+    memcpy(snapshot->text, editor_text, editor_length + 1);
+    snapshot->length = editor_length;
+    snapshot->cursor = editor_cursor;
+    snapshot->anchor = editor_selection_anchor;
+    snapshot->dirty = editor_dirty;
+    return 1;
+}
