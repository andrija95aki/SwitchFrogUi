+static int editor_open_file(const char *path) {
+    FILE *file;
+    long size;
+    if (!path || !editor_buffer_ready()) return 0;
+    file = fopen(path, "rb");
+    if (!file) { ui_notice("Could not open file"); return 0; }
+    if (fseek(file, 0, SEEK_END) != 0 || (size = ftell(file)) < 0 || size > EDITOR_BUFFER_CAP) {
+        fclose(file); ui_notice("Text files must be 128KB or smaller"); return 0;
+    }
+    rewind(file);
+    editor_length = size ? fread(editor_text, 1, (size_t)size, file) : 0;
+    fclose(file);
+    for (size_t i = 0; i < editor_length; i++) if (!editor_text[i]) editor_text[i] = ' ';
+    editor_text[editor_length] = '\0';
+    snprintf(editor_file_path, sizeof(editor_file_path), "%s", path);
+    editor_cursor = 0; editor_top_line = 0; editor_left_column = 0;
+    editor_selection_anchor = 0;
+    editor_history_clear_stack(editor_undo, &editor_undo_count);
+    editor_history_clear_stack(editor_redo, &editor_redo_count);
+    editor_dirty = false; text_editor_active = true;
+    editor_keyboard_drain();
+    virtual_keyboard_prepare();
