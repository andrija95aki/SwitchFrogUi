+    for(size_t i=0;i<editor_cursor;i++) {
+        if(editor_text[i]=='\n'){cursor_line++;cursor_column=0;} else cursor_column++;
+    }
+    if(editor_has_selection()) editor_selection_bounds(&selection_start,&selection_end);
+    for(int line=0;line<editor_top_line && offset<editor_length;line++) {
+        while(offset<editor_length && editor_text[offset]!='\n') offset++;
+        if(offset<editor_length) offset++;
