+static void launcher_blend_round_rect(int x,int y,int w,int h,int radius,
+                                      uint16_t color,int amount) {
+    int x0=x<0?0:x, y0=y<0?0:y;
+    int x1=x+w>SCREEN_WIDTH?SCREEN_WIDTH:x+w;
+    int y1=y+h>SCREEN_HEIGHT?SCREEN_HEIGHT:y+h;
+    if(radius<1) radius=1;
+    for(int py=y0;py<y1;py++) for(int px=x0;px<x1;px++) {
+        int inside=(px>=x+radius && px<x+w-radius) ||
+                   (py>=y+radius && py<y+h-radius);
+        if(!inside) {
+            int cx=px<x+radius?x+radius-1:x+w-radius;
+            int cy=py<y+radius?y+radius-1:y+h-radius;
+            int dx=px-cx,dy=py-cy;
+            inside=dx*dx+dy*dy<=radius*radius;
+        }
+        if(inside) {
+            uint16_t *p=&framebuffer[py*SCREEN_WIDTH+px];
+            *p=ui_mix565(*p,color,amount);
+        }
+    }
 }
 
