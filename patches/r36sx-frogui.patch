+static int file_regular_size(const char *path, uint64_t *bytes) {
+    int fd = open(path, O_RDONLY);
+    if (fd < 0) return 0;
+    off_t end = lseek(fd, 0, SEEK_END);
+    close(fd);
+    if (end < 0) return 0;
+    *bytes = (uint64_t)end;
+    return 1;
+}
+
+static int file_measure_tree(const char *path, int is_dir, int depth,
+                             uint64_t *bytes, unsigned *files, unsigned *dirs) {
+    if (depth > 24 || directory_lock_related_index(path) >= 0) return 0;
+    if (!is_dir) {
+        uint64_t size = 0;
+        if (!file_regular_size(path, &size)) return 0;
+        *bytes += size; (*files)++; return 1;
     }
+    (*dirs)++;
+    DIR *dir = opendir(path); struct dirent *entry; int ok = dir != NULL;
+    while (dir && ok && (entry = readdir(dir)) != NULL) {
+        if (!strcmp(entry->d_name, ".") || !strcmp(entry->d_name, "..")) continue;
+        char child[MAX_PATH_LEN];
+        if (snprintf(child, sizeof(child), "%s/%s", path, entry->d_name) >= (int)sizeof(child)) { ok = 0; break; }
+        ok = file_measure_tree(child, dirent_is_directory(child, entry), depth + 1,
+                               bytes, files, dirs);
+    }
+    if (dir) closedir(dir);
+    return ok;
+}
 
