+uint16_t theme_gradient_color(const Theme *theme, int position, int maximum) {
+    if(!theme || !theme->gradient || maximum<=0) return theme ? theme->bg : 0;
+    int stops=theme->gradient==1 ? 2 : theme->gradient;
+    if(stops<2) stops=2; if(stops>4) stops=4;
+    uint16_t colors[4]={theme->bg,theme->bg2,theme->bg3,theme->bg4};
+    int scaled=position*(stops-1);
+    int segment=scaled/maximum;
+    if(segment>=stops-1) return colors[stops-1];
+    int local=scaled-segment*maximum;
+    uint16_t a=colors[segment],b=colors[segment+1];
+    int ar=(a>>11)&31,ag=(a>>5)&63,ab=a&31;
+    int br=(b>>11)&31,bg=(b>>5)&63,bb=b&31;
+    int r=(ar*(maximum-local)+br*local)/maximum;
+    int g=(ag*(maximum-local)+bg*local)/maximum;
+    int bl=(ab*(maximum-local)+bb*local)/maximum;
+    return (uint16_t)((r<<11)|(g<<5)|bl);
+}
