+static void ui_sound_load_pack(void) {
+    if(ui_loaded_sound_pack==settings_sound_pack) return;
+    ui_sound_free_clips(); ui_loaded_sound_pack=settings_sound_pack;
+    if(settings_sound_pack<2) return;
+    static const char *pack_dirs[]={"bright","soft","cyber"};
+    static const char *events[]={"move","confirm","back"};
+    int p=settings_sound_pack-2;
+    for(int i=0;i<3;i++) {
+        char path[160]; snprintf(path,sizeof(path),"/mnt/sdcard/frogui/sounds/%s_%s.wav",pack_dirs[p],events[i]);
+        ui_sound_load_wav(path,&ui_clips[i]);
+    }
+}
