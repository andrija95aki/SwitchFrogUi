+/* Hardware information is read from procfs/device-tree when the page is
+ * rendered. H.OS does not expose a serial on every board, so never invent one:
+ * show a clear unavailable value when neither device-tree nor cpuinfo has it. */
+static void trim_info_value(char *value) {
+    char *start = value;
+    while (*start && (unsigned char)*start <= ' ') start++;
+    if (start != value) memmove(value, start, strlen(start) + 1);
+    size_t len = strlen(value);
+    while (len && (unsigned char)value[len - 1] <= ' ') value[--len] = '\0';
+}
+
+static int read_text_value(const char *path, char *out, size_t out_size) {
+    if (!out || out_size < 2) return 0;
+    out[0] = '\0';
+    FILE *f = fopen(path, "rb");
+    if (!f) return 0;
+    size_t got = fread(out, 1, out_size - 1, f);
+    fclose(f);
+    out[got] = '\0';
+    trim_info_value(out);
+    return out[0] != '\0';
+}
+
+static int read_proc_field(const char *path, const char *wanted,
+                           char *out, size_t out_size) {
+    FILE *f = fopen(path, "r");
+    if (!f) return 0;
+    char line[256];
+    int found = 0;
+    while (fgets(line, sizeof(line), f)) {
+        char *colon = strchr(line, ':');
+        if (!colon) continue;
+        *colon = '\0';
+        trim_info_value(line);
+        if (strcasecmp(line, wanted) != 0) continue;
+        strncpy(out, colon + 1, out_size - 1);
+        out[out_size - 1] = '\0';
+        trim_info_value(out);
+        found = out[0] != '\0';
+        break;
+    }
+    fclose(f);
+    return found;
+}
+
+static void shorten_info_value(char *value, size_t maximum) {
+    size_t len = strlen(value);
+    if (maximum < 4 || len <= maximum) return;
+    value[maximum - 3] = '.';
+    value[maximum - 2] = '.';
+    value[maximum - 1] = '.';
+    value[maximum] = '\0';
+}
+
+static void format_card_space(char *out, size_t out_size) {
+    struct statvfs fs;
+    if (statvfs(SDCARD_BASE, &fs) != 0 || fs.f_blocks == 0) {
+        snprintf(out, out_size, "Unavailable");
+        return;
+    }
+    unsigned long long unit = fs.f_frsize ? fs.f_frsize : fs.f_bsize;
+    unsigned long long total_mib = unit * (unsigned long long)fs.f_blocks / 1048576ULL;
+    unsigned long long free_mib = unit * (unsigned long long)fs.f_bavail / 1048576ULL;
+    if (total_mib >= 1024ULL) {
+        unsigned long long total_tenths = total_mib * 10ULL / 1024ULL;
+        unsigned long long free_tenths = free_mib * 10ULL / 1024ULL;
+        snprintf(out, out_size, "%llu.%llu GB / %llu.%llu free",
+                 total_tenths / 10ULL, total_tenths % 10ULL,
+                 free_tenths / 10ULL, free_tenths % 10ULL);
+    } else {
+        snprintf(out, out_size, "%llu MB / %llu free", total_mib, free_mib);
+    }
+}
