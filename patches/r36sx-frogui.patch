+static int editor_save(void) {
+    FILE *file;
+    if (!editor_file_path[0] || !editor_buffer_ready()) return 0;
+    file = fopen(editor_file_path, "wb");
+    if (!file) { ui_notice("Could not save file"); return 0; }
+    if (editor_length && fwrite(editor_text, 1, editor_length, file) != editor_length) {
+        fclose(file); ui_notice("Write failed"); return 0;
+    }
+    fflush(file); fsync(fileno(file)); fclose(file); sync();
+    editor_dirty = false;
+    ui_notice("File saved");
+    return 1;
+}
