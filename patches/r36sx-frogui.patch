+/* Keep the viewer inside the current file-manager directory and wrap between
+ * image files. Failed/unsupported neighbours leave the current photo open. */
+static void photo_viewer_step(int direction) {
+    if (entry_count <= 0) return;
+    int start = selected_index;
+    for (int i = 1; i <= entry_count; i++) {
+        int idx = (start + direction * i) % entry_count;
+        if (idx < 0) idx += entry_count;
+        if (entries[idx].is_dir || !is_image_file(entries[idx].name)) continue;
+        char path[MAX_PATH_LEN];
+        snprintf(path, sizeof(path), "%s/%s", current_path, entries[idx].name);
+        if (photo_viewer_open(path)) {
+            selected_index = idx;
+            ui_rendered_once = 0;
+            return;
+        }
+    }
+    ui_notice("No other photos in this folder");
