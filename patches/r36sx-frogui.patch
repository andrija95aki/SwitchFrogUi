+static void render_text_editor(void) {
+    int percent=95, cw=font_mono_char_width(percent), lh=font_mono_line_height(percent);
+    int columns=(SCREEN_WIDTH-PADDING*2)/cw;
+    int visible=(SCREEN_HEIGHT-UI_S(104))/lh;
+    int cursor_line=0,cursor_column=0;
+    size_t offset=0,selection_start=editor_cursor,selection_end=editor_cursor;
+    char title[160],status[160];
