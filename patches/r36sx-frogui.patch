+/* Affected R36SX panels scan the first 110 columns one row too high. Pre-roll
+ * only that band down by one row (with wrap) so the panel fault cancels it.
+ * The rest of the 640x480 image is copied bit-for-bit: no crop, squeeze, or
+ * aspect-ratio change. */
+static const uint16_t *present_framebuffer(int refresh) {
+    const int band_w = 110;
+    const int y_fix = 1;
+    /* When the boot script preloads the display shim into picoarch, that shim
+     * corrects this framebuffer and every exec-chained emulator. Do not apply
+     * FrogUI's built-in transform as well. */
+    static int externally_fixed = -1;
+    if(externally_fixed<0)
+        externally_fixed=getenv("TF_R36SX_DISPLAYFIX_PRELOADED") ? 1 : 0;
+    if (!settings_r36sx_display_fix || !displayfix_framebuffer ||
+        externally_fixed || SCREEN_WIDTH != 640 || SCREEN_HEIGHT != 480)
+        return framebuffer;
+    if (!refresh) return displayfix_framebuffer;
+
+    for (int y = 0; y < SCREEN_HEIGHT; y++) {
+        uint16_t *dst = displayfix_framebuffer + (size_t)y * SCREEN_WIDTH;
+        const uint16_t *src = framebuffer + (size_t)y * SCREEN_WIDTH;
+        const int band_sy = (y - y_fix + SCREEN_HEIGHT) % SCREEN_HEIGHT;
+        memcpy(dst, framebuffer + (size_t)band_sy * SCREEN_WIDTH,
+               (size_t)band_w * sizeof(uint16_t));
+        memcpy(dst + band_w, src + band_w,
+               (size_t)(SCREEN_WIDTH - band_w) * sizeof(uint16_t));
+    }
+    return displayfix_framebuffer;
+}
