+#define EDITOR_HISTORY_DEPTH 8
+typedef struct {
+    char *text;
+    size_t length, cursor, anchor;
+    bool dirty;
+} EditorSnapshot;
+static EditorSnapshot editor_undo[EDITOR_HISTORY_DEPTH];
+static EditorSnapshot editor_redo[EDITOR_HISTORY_DEPTH];
+static int editor_undo_count, editor_redo_count;
