+    snprintf(status, sizeof(status), state->connected
+                 ? "%d keyboard%s / %u events"
+                 : "Waiting - connect USB keyboard",
+             state->connected, state->connected == 1 ? "" : "s", state->event_count);
+    snprintf(device, sizeof(device), "%s", state->device[0] ? state->device : "Not detected");
+    snprintf(name, sizeof(name), "%s", state->name[0] ? state->name : "Waiting for USB keyboard");
+    snprintf(held, sizeof(held), "%s", state->held[0] ? state->held : "None");
+    snprintf(modifiers, sizeof(modifiers), "%s", state->modifiers[0] ? state->modifiers : "None");
+    snprintf(recent0, sizeof(recent0), "%s", state->recent[0][0] ? state->recent[0] : "Press any keyboard key");
+    snprintf(recent1, sizeof(recent1), "%s", state->recent[1][0] ? state->recent[1] : "-");
+    shorten_info_value(status, 32);
+    shorten_info_value(device, 32);
+    shorten_info_value(name, 32);
+    shorten_info_value(held, 32);
