+static int scan_platform_games(const char *root, const char *relative, int depth) {
+    if (depth > 6) return 1;
+    char dir_path[MAX_PATH_LEN];
+    if (relative && *relative)
+        snprintf(dir_path, sizeof(dir_path), "%s/%s", root, relative);
+    else
+        snprintf(dir_path, sizeof(dir_path), "%s", root);
+    DIR *dir = opendir(dir_path);
+    if (!dir) return 1;
+    struct dirent *e;
+    while ((e = readdir(dir)) != NULL) {
+        if (e->d_name[0] == '.') continue;
+        char full[MAX_PATH_LEN];
+        snprintf(full, sizeof(full), "%s/%s", dir_path, e->d_name);
+        int is_dir = dirent_is_directory(full, e);
+        if (is_dir) {
+            if (is_artwork_dir_name(e->d_name)) continue;
+            char child[256];
+            if (relative && *relative)
+                snprintf(child, sizeof(child), "%s/%s", relative, e->d_name);
+            else
+                snprintf(child, sizeof(child), "%s", e->d_name);
+            if (!scan_platform_games(root, child, depth + 1)) { closedir(dir); return 0; }
+        } else if (!is_metadata_file_name(e->d_name)) {
+            char item[256];
+            if (relative && *relative)
+                snprintf(item, sizeof(item), "%s/%s", relative, e->d_name);
+            else
+                snprintf(item, sizeof(item), "%s", e->d_name);
+            if (!append_entry(item, 0)) { closedir(dir); return 0; }
+        }
+    }
+    closedir(dir);
+    return 1;
+}
