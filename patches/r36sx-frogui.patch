+static void launcher_draw_icon(const char *name, int x, int y, int w, int h) {
+    uint16_t c = 0xFFFF;
+    int cx = x + w / 2, cy = y + h / 2;
+    int u = UI_S(4);
+    if (!strcmp(name, MUSIC_ENTRY_NAME)) {
+        render_fill_rect(framebuffer, cx + u, cy - UI_S(25), u, UI_S(38), c);
+        render_fill_rect(framebuffer, cx + u, cy - UI_S(25), UI_S(20), u, c);
+        render_rounded_rect(framebuffer, cx - UI_S(12), cy + UI_S(7), UI_S(20), UI_S(14), UI_S(7), c);
+    } else if (!strcmp(name, VIDEOS_ENTRY_NAME)) {
+        /* Film frame with a play triangle. */
+        uint16_t cut=launcher_tile_color(name,0);
+        render_rounded_rect(framebuffer,cx-UI_S(32),cy-UI_S(23),UI_S(64),UI_S(46),UI_S(5),c);
+        render_fill_rect(framebuffer,cx-UI_S(25),cy-UI_S(17),UI_S(50),UI_S(34),cut);
+        for(int i=-1;i<=1;i++) {
+            render_rounded_rect(framebuffer,cx-UI_S(29),cy+i*UI_S(13)-UI_S(3),UI_S(5),UI_S(6),UI_S(1),cut);
+            render_rounded_rect(framebuffer,cx+UI_S(24),cy+i*UI_S(13)-UI_S(3),UI_S(5),UI_S(6),UI_S(1),cut);
+        }
+        for(int row=0;row<17;row++)
+            render_fill_rect(framebuffer,cx-UI_S(7)+row/2,cy-UI_S(12)+row,UI_S(3),UI_S(2),c);
+    } else if (!strcmp(name, FILES_ENTRY_NAME)) {
+        render_rounded_rect(framebuffer, cx - UI_S(30), cy - UI_S(16), UI_S(60), UI_S(40), UI_S(5), c);
+        render_fill_rect(framebuffer, cx - UI_S(25), cy - UI_S(23), UI_S(26), UI_S(12), c);
+    } else if (!strcmp(name, SETTINGS_ENTRY_NAME)) {
+        /* Cog wheel: eight teeth, solid rim, and a clear centre bore. */
+        uint16_t cut=launcher_tile_color(name,0);
+        for(int i=0;i<8;i++) {
+            float a=(float)i*0.78539816f;
+            int tx=cx+(int)(cosf(a)*UI_S(29))-UI_S(5);
+            int ty=cy+(int)(sinf(a)*UI_S(29))-UI_S(5);
+            render_rounded_rect(framebuffer,tx,ty,UI_S(10),UI_S(10),UI_S(2),c);
+        }
+        render_rounded_rect(framebuffer,cx-UI_S(25),cy-UI_S(25),UI_S(50),UI_S(50),UI_S(25),c);
+        render_rounded_rect(framebuffer,cx-UI_S(16),cy-UI_S(16),UI_S(32),UI_S(32),UI_S(16),cut);
+        render_rounded_rect(framebuffer,cx-UI_S(7),cy-UI_S(7),UI_S(14),UI_S(14),UI_S(7),c);
+    } else if (!strcmp(name, RECENTS_ENTRY_NAME)) {
