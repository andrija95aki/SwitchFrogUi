+static int load_art_from_dir(const char *dir, const char *base, Thumbnail *thumb) {
+    static const char *const layouts[] = {
+        ".res", "images", "Imgs", "media", "boxart", NULL
+    };
+    char candidate[1024];
+    for (int i = 0; layouts[i]; i++) {
+        snprintf(candidate, sizeof(candidate), "%s/%s/%s", dir, layouts[i], base);
+        if (load_thumbnail(candidate, thumb)) return 1;
+    }
