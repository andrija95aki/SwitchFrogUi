+static uint16_t blend565_coverage(uint16_t background, uint16_t foreground, int coverage) {
+    int inverse=16-coverage;
+    int br=(background>>11)&31, bg=(background>>5)&63, bb=background&31;
+    int fr=(foreground>>11)&31, fg=(foreground>>5)&63, fb=foreground&31;
+    return (uint16_t)((((fr*coverage+br*inverse)/16)<<11)|
+                      (((fg*coverage+bg*inverse)/16)<<5)|
+                       ((fb*coverage+bb*inverse)/16));
+}
