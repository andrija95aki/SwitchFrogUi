+static int editor_find_next(const char *needle) {
+    char *match;
+    size_t start;
+    if (!needle || !needle[0] || !editor_text) return 0;
+    start = editor_cursor < editor_length ? editor_cursor + 1 : 0;
+    match = strstr(editor_text + start, needle);
+    if (!match && start) match = strstr(editor_text, needle);
+    if (!match) { ui_notice("Text not found"); return 0; }
+    editor_selection_anchor = (size_t)(match - editor_text);
+    editor_cursor = editor_selection_anchor + strlen(needle);
