+static void render_rom_cards(void) {
+    const int cols=4, rows=2, visible=cols*rows;
+    int count=viewing_favourites?favorites_get_count():entry_count;
+    if(selected_index<0) selected_index=0;
+    if(selected_index>=count && count>0) selected_index=count-1;
+    int first=(selected_index/visible)*visible;
+    int gap=UI_S(7), xpad=PADDING;
+    int cw=(SCREEN_WIDTH-xpad*2-gap*(cols-1))/cols;
+    int ch=UI_S(108), top=START_Y;
+    render_clear_screen(framebuffer);
+    char search_header[96];
+    if(viewing_search) snprintf(search_header,sizeof(search_header),"SEARCH: %s (%d)",search_query,count);
+    render_header(framebuffer,viewing_favourites?"FAVOURITES":viewing_search?search_header:get_basename(current_path));
+    for(int slot=0;slot<visible;slot++) {
+        int idx=first+slot; if(idx>=count) break;
+        int col=slot%cols,row=slot/cols;
+        int x=xpad+col*(cw+gap), y=top+row*(ch+gap);
+        bool selected=idx==selected_index;
+        uint16_t card=ui_mix565(COLOR_BG,COLOR_TEXT,24);
+        if(selected) render_rounded_rect(framebuffer,x-UI_S(2),y-UI_S(2),cw+UI_S(4),ch+UI_S(4),UI_S(7),COLOR_SELECT_BG);
+        render_rounded_rect(framebuffer,x,y,cw,ch,UI_S(6),card);
