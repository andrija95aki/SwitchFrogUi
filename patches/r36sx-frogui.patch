+static void launcher_draw_card_glow(int x,int y,int w,int h,uint16_t color) {
+    /* Fifteen physical pixels around the selected card. Drawn before all cards,
+     * so a neighbouring card always remains above any overlapping glow. */
+    for(int spread=15;spread>=3;spread-=3) {
+        int amount=45+(15-spread)*10;
+        uint16_t c=ui_mix565(COLOR_BG,color,amount);
+        render_rounded_rect_aa(framebuffer,x-spread,y-spread,w+spread*2,h+spread*2,
+                               UI_S(10)+spread,c);
+    }
+}
