+/* A console-home-style horizontal launcher.  It deliberately uses only FrogUI's
+ * RGB565 primitives so it remains fast and asset-independent on every panel. */
+static void draw_star_icon(int cx, int cy, int radius, uint16_t color) {
+    float vx[10], vy[10];
+    for (int i=0;i<10;i++) {
+        float a=-1.5707963f+(float)i*0.6283185f;
+        float r=(i&1)?radius*0.43f:(float)radius;
+        vx[i]=cx+cosf(a)*r; vy[i]=cy+sinf(a)*r;
+    }
+    for(int y=cy-radius;y<=cy+radius;y++) for(int x=cx-radius;x<=cx+radius;x++) {
+        int inside=0;
+        for(int i=0,j=9;i<10;j=i++)
+            if (((vy[i]>y)!=(vy[j]>y)) &&
+                (x < (vx[j]-vx[i])*(y-vy[i])/(vy[j]-vy[i])+vx[i])) inside=!inside;
+        if(inside && x>=0 && x<SCREEN_WIDTH && y>=0 && y<SCREEN_HEIGHT)
+            framebuffer[y*SCREEN_WIDTH+x]=color;
+    }
+}
