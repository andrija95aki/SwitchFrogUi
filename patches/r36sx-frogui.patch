+void render_rounded_rect_aa(uint16_t *framebuffer, int x, int y, int width, int height,
+                            int radius, uint16_t color) {
+    if(!framebuffer || width<=0 || height<=0) return;
+    if(radius<1){render_fill_rect(framebuffer,x,y,width,height,color);return;}
+    if(radius*2>width) radius=width/2;
+    if(radius*2>height) radius=height/2;
+    render_fill_rect(framebuffer,x+radius,y,width-radius*2,height,color);
+    render_fill_rect(framebuffer,x,y+radius,width,height-radius*2,color);
+
+    int center=radius*8, radius_sq=center*center;
+    for(int py=0;py<radius;py++) for(int px=0;px<radius;px++) {
+        int coverage=0;
+        for(int sy=0;sy<4;sy++) for(int sx=0;sx<4;sx++) {
+            int dx=px*8+(sx*2+1)-center;
+            int dy=py*8+(sy*2+1)-center;
+            if(dx*dx+dy*dy<=radius_sq) coverage++;
+        }
+        if(!coverage) continue;
+        int corners[4][2]={{x+px,y+py},{x+width-1-px,y+py},
+                           {x+px,y+height-1-py},{x+width-1-px,y+height-1-py}};
+        for(int i=0;i<4;i++) {
+            int tx=corners[i][0],ty=corners[i][1];
+            if(tx<0||tx>=SCREEN_WIDTH||ty<0||ty>=SCREEN_HEIGHT) continue;
+            uint16_t *pixel=&framebuffer[ty*SCREEN_WIDTH+tx];
+            *pixel=coverage==16?color:blend565_coverage(*pixel,color,coverage);
+        }
+    }
+}
