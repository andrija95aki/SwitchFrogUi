+static int photo_viewer_open(const char *path) {
+    int w = 0, h = 0, channels = 0;
+    /* BMP permits a negative height to mark top-down row order. stb_image's
+     * info probe preserves that sign, while stbi_load() correctly normalizes
+     * and decodes it. The R36SX screenshot writer emits exactly this valid
+     * 640x-480 form, so validate its magnitude instead of rejecting it. */
+    if (!path || !stbi_info(path, &w, &h, &channels) || w <= 0 || h == 0 ||
+        (size_t)w * (size_t)(h < 0 ? -(int64_t)h : h) > 16000000u) {
+        ui_notice("Image is unsupported or too large");
+        return 0;
+    }
+    unsigned char *rgba = stbi_load(path, &w, &h, &channels, 4);
+    if (!rgba) {
+        ui_notice("Could not decode image");
+        return 0;
+    }
+    size_t count = (size_t)w * (size_t)h;
+    uint16_t *pixels = malloc(count * sizeof(*pixels));
+    if (!pixels) {
+        stbi_image_free(rgba);
+        ui_notice("Not enough memory for image");
+        return 0;
+    }
+    /* Composite transparency over a subtle checkerboard so transparent PNGs
+     * remain legible instead of turning into opaque black shapes. */
+    for (int y = 0; y < h; y++) for (int x = 0; x < w; x++) {
+        size_t i = (size_t)y * w + x;
+        const unsigned char *p = rgba + i * 4;
+        unsigned a = p[3], bg = ((x / 12 + y / 12) & 1) ? 42u : 24u;
+        unsigned r = (p[0] * a + bg * (255u - a)) / 255u;
+        unsigned g = (p[1] * a + bg * (255u - a)) / 255u;
+        unsigned b = (p[2] * a + bg * (255u - a)) / 255u;
+        pixels[i] = (uint16_t)(((r & 0xf8u) << 8) |
+                               ((g & 0xfcu) << 3) | (b >> 3));
+    }
+    stbi_image_free(rgba);
+    photo_viewer_close();
+    photo_pixels = pixels;
+    photo_width = w; photo_height = h;
+    strncpy(photo_path, path, sizeof(photo_path) - 1);
+    photo_path[sizeof(photo_path) - 1] = '\0';
+    photo_viewer_active = true;
+    banner_clear();
+    return 1;
+}
