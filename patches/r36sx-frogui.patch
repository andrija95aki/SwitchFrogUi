+static bool game_has_save(const char *game_path) {
+    char base[256], tag[64], parent[MAX_PATH_LEN], p[MAX_PATH_LEN*2];
+    game_display_name(game_path,base,sizeof(base));
+    strncpy(parent,game_path,sizeof(parent)-1); parent[sizeof(parent)-1]='\0';
+    char *slash=strrchr(parent,'/'); if(!slash) return false; *slash='\0';
+    const char *t=strrchr(parent,'/'); t=t?t+1:parent;
+    strncpy(tag,t,sizeof(tag)-1); tag[sizeof(tag)-1]='\0';
+    static const char *const ext[]={"sav","srm","state","st0","st1","st2","st3","st4","st5","st6","st7","st8","st9",NULL};
+    for(int i=0;ext[i];i++) {
+        snprintf(p,sizeof(p),SDCARD_BASE "/picoarch/%s/%s.%s",tag,base,ext[i]);
+        if(access(p,F_OK)==0) return true;
+    }
+    return false;
+}
+
+/* Save states do not carry a portable creation-time field. Track the game's
+ * accumulated playtime against a cheap content fingerprint instead. When a
+ * slot changes after returning from a game, its new playtime is captured the
+ * next time details are opened. Existing slots are initialized on first view. */
+#define STATE_PLAYTIME_FILE SDCARD_BASE "/frogui/state_playtime.txt"
+
+static uint32_t state_file_fingerprint(const char *path, long *size_out) {
+    FILE *f=fopen(path,"rb"); if(!f) return 0;
+    if(fseek(f,0,SEEK_END)!=0) { fclose(f); return 0; }
+    long size=ftell(f); if(size<0) { fclose(f); return 0; }
+    uint32_t h=2166136261u ^ (uint32_t)size;
+    unsigned char buf[2048];
+    size_t got;
+    rewind(f);
+    got=fread(buf,1,sizeof(buf),f);
+    for(size_t i=0;i<got;i++) { h^=buf[i]; h*=16777619u; }
+    if(size>(long)sizeof(buf)) {
+        long tail=size-(long)sizeof(buf);
+        if(fseek(f,tail,SEEK_SET)==0) {
+            got=fread(buf,1,sizeof(buf),f);
+            for(size_t i=0;i<got;i++) { h^=buf[i]; h*=16777619u; }
+        }
+    }
+    fclose(f); if(size_out) *size_out=size;
+    return h ? h : 1u;
+}
+
+static long save_state_playtime(const char *state_path, const char *game_path) {
+    long size=0, found=-1;
+    uint32_t sig=state_file_fingerprint(state_path,&size);
+    if(!sig) return 0;
+    FILE *f=fopen(STATE_PLAYTIME_FILE,"r");
+    if(f) {
+        char line[MAX_PATH_LEN*2+96];
+        while(fgets(line,sizeof(line),f)) {
+            char *t1=strchr(line,'\t'); if(!t1) continue; *t1++='\0';
+            char *t2=strchr(t1,'\t'); if(!t2) continue; *t2++='\0';
+            char *t3=strchr(t2,'\t'); if(!t3) continue; *t3++='\0';
+            t3[strcspn(t3,"\r\n")]='\0';
+            if((uint32_t)strtoul(line,NULL,16)==sig && atol(t1)==size &&
+               !strcmp(t3,state_path)) found=atol(t2);
+        }
+        fclose(f);
+    }
+    if(found>=0) return found;
+    long current=playtime_lookup(game_path);
+    f=fopen(STATE_PLAYTIME_FILE,"a");
+    if(f) {
+        fprintf(f,"%08lx\t%ld\t%ld\t%s\n",(unsigned long)sig,size,current,state_path);
+        fflush(f); fsync(fileno(f)); fclose(f);
+    }
+    return current;
+}
+
+static void format_played_duration(long sec, char *out, size_t n) {
+    if(sec>=3600) snprintf(out,n,"%ldH %ldM PLAYED",sec/3600,(sec%3600)/60);
+    else if(sec>=60) snprintf(out,n,"%ldM PLAYED",sec/60);
+    else snprintf(out,n,"%ldS PLAYED",sec);
+}
+
+typedef struct { char label[24]; char path[MAX_PATH_LEN*2]; char played[32]; } GameSaveState;
+
+static int collect_game_save_states(const char *game_path, GameSaveState *states, int cap) {
+    char base[256], parent[MAX_PATH_LEN], tag[64]; int count=0;
+    game_display_name(game_path,base,sizeof(base));
+    strncpy(parent,game_path,sizeof(parent)-1); parent[sizeof(parent)-1]='\0';
+    char *slash=strrchr(parent,'/'); if(!slash) return 0; *slash='\0';
+    const char *folder=strrchr(parent,'/'); folder=folder?folder+1:parent;
+    strncpy(tag,folder,sizeof(tag)-1); tag[sizeof(tag)-1]='\0';
+    static const char *const ext[]={"state","st0","st1","st2","st3","st4","st5","st6","st7","st8","st9",NULL};
+    for(int i=0;ext[i] && count<cap;i++) {
+        char path[MAX_PATH_LEN*2];
+        snprintf(path,sizeof(path),SDCARD_BASE "/picoarch/%s/%s.%s",tag,base,ext[i]);
+        if(access(path,F_OK)!=0) continue;
+        if(i==0) strncpy(states[count].label,"Auto state",sizeof(states[count].label)-1);
+        else snprintf(states[count].label,sizeof(states[count].label),"State %d",i-1);
+        states[count].label[sizeof(states[count].label)-1]='\0';
+        strncpy(states[count].path,path,sizeof(states[count].path)-1);
+        states[count].path[sizeof(states[count].path)-1]='\0';
+        format_played_duration(save_state_playtime(path,game_path),
+                               states[count].played,sizeof(states[count].played));
+        count++;
+    }
+    return count;
+}
+
+static void draw_wrapped_scaled(const char *text, int x, int y, int max_w,
+                                int max_lines, int percent, uint16_t color) {
+    char line[128]; const char *p=text; int line_no=0;
+    while(*p && line_no<max_lines) {
+        int len=0,last_space=-1;
+        while(p[len] && len<(int)sizeof(line)-1) {
+            line[len]=p[len]; line[len+1]='\0';
+            if(p[len]==' ') last_space=len;
+            if(font_measure_text_scaled(line,percent)>max_w) break;
+            len++;
+        }
+        if(p[len] && last_space>0) len=last_space;
+        if(len<1) len=1;
+        memcpy(line,p,(size_t)len); line[len]='\0';
+        while(len>0 && line[len-1]==' ') line[--len]='\0';
+        if(line_no==max_lines-1 && p[len]) {
+            while(len>2 && font_measure_text_scaled(line,percent)>max_w-UI_S(12)) line[--len]='\0';
+            strncat(line,"..",sizeof(line)-strlen(line)-1);
+        }
+        font_draw_text_scaled(framebuffer,SCREEN_WIDTH,SCREEN_HEIGHT,x,y+line_no*UI_S(17),line,color,percent);
+        p+=len; while(*p==' ') p++;
+        line_no++;
+    }
+}
