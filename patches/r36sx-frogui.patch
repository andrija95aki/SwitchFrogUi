+static int editor_has_selection(void) {
+    return editor_cursor != editor_selection_anchor;
+}
+
+static void editor_selection_bounds(size_t *start, size_t *end) {
+    if (editor_cursor < editor_selection_anchor) {
+        *start = editor_cursor; *end = editor_selection_anchor;
+    } else {
+        *start = editor_selection_anchor; *end = editor_cursor;
+    }
+}
+
+static void editor_replace_selection(const char *text, size_t length) {
+    size_t start, end, removed;
+    if (!editor_buffer_ready()) return;
+    editor_selection_bounds(&start, &end); removed = end - start;
+    if (editor_length - removed + length > EDITOR_BUFFER_CAP) {
+        ui_notice("128KB editor limit reached"); return;
+    }
+    editor_history_checkpoint();
+    memmove(editor_text + start + length, editor_text + end,
+            editor_length - end + 1);
+    if (length) memcpy(editor_text + start, text, length);
+    editor_length = editor_length - removed + length;
+    editor_cursor = start + length;
+    editor_selection_anchor = editor_cursor;
+    editor_dirty = true;
+}
+
+static void editor_insert_char(char c) {
+    editor_replace_selection(&c, 1);
+}
+
+static void editor_copy_selection(void) {
+    size_t start, end, length;
+    char *copy;
+    if (!editor_has_selection()) return;
+    editor_selection_bounds(&start, &end); length = end - start;
+    copy = (char *)realloc(editor_clipboard, length + 1);
+    if (!copy) { ui_notice("Clipboard allocation failed"); return; }
+    editor_clipboard = copy;
+    memcpy(editor_clipboard, editor_text + start, length);
+    editor_clipboard[length] = '\0'; editor_clipboard_length = length;
+    ui_notice("Copied");
+}
+
+static void editor_cut_selection(void) {
+    if (!editor_has_selection()) return;
+    editor_copy_selection();
+    editor_replace_selection(NULL, 0);
+    ui_notice("Cut");
+}
+
+static void editor_paste(void) {
+    if (editor_clipboard && editor_clipboard_length)
+        editor_replace_selection(editor_clipboard, editor_clipboard_length);
+}
+
+static size_t editor_word_left(size_t position) {
+    while (position > 0 && isspace((unsigned char)editor_text[position - 1])) position--;
+    while (position > 0 && !isspace((unsigned char)editor_text[position - 1])) position--;
+    return position;
+}
+
+static size_t editor_word_right(size_t position) {
+    while (position < editor_length && !isspace((unsigned char)editor_text[position])) position++;
+    while (position < editor_length && isspace((unsigned char)editor_text[position])) position++;
+    return position;
+}
+
+static size_t editor_line_start(size_t position) {
+    while (position > 0 && editor_text[position - 1] != '\n') position--;
+    return position;
+}
+
+static size_t editor_line_end(size_t position) {
+    while (position < editor_length && editor_text[position] != '\n') position++;
+    return position;
+}
+
+static void editor_move_vertical(int direction) {
+    size_t start = editor_line_start(editor_cursor);
+    size_t column = editor_cursor - start;
+    if (direction < 0) {
+        if (!start) return;
+        size_t previous_end = start - 1;
+        size_t previous_start = editor_line_start(previous_end);
+        size_t width = previous_end - previous_start;
+        editor_cursor = previous_start + (column < width ? column : width);
+    } else {
+        size_t end = editor_line_end(editor_cursor);
+        if (end >= editor_length) return;
+        size_t next_start = end + 1, next_end = editor_line_end(next_start);
+        size_t width = next_end - next_start;
+        editor_cursor = next_start + (column < width ? column : width);
+    }
+}
