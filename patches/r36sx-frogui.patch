 #ifndef UI_SCALE
 #define UI_SCALE 100
 #endif
 #define FONT_SIZE (20.0f * UI_SCALE / 100.0f)
 
+static int load_mono_font(void) {
+    static const char *names[] = { "SpaceMono-Regular.ttf", "ShareTechMono-Regular.ttf", "monogram.ttf" };
+    char path[256];
+    if (mono_font_loaded) return 1;
+    for (int name = 0; name < 3; name++) {
+        static const char *dirs[] = {
+            "/mnt/sdcard/frogui/fonts", "/mnt/sdcard/cubegm/fonts", "fonts"
+        };
+        for (int dir = 0; dir < 3; dir++) {
+            FILE *fp;
+            long size;
+            snprintf(path, sizeof(path), "%s/%s", dirs[dir], names[name]);
+            fp = fopen(path, "rb");
+            if (!fp) continue;
+            fseek(fp, 0, SEEK_END); size = ftell(fp); fseek(fp, 0, SEEK_SET);
+            if (size <= 0) { fclose(fp); continue; }
+            mono_font_buffer = (unsigned char *)malloc((size_t)size);
+            if (!mono_font_buffer) { fclose(fp); return 0; }
+            if (fread(mono_font_buffer, 1, (size_t)size, fp) != (size_t)size) {
+                fclose(fp); free(mono_font_buffer); mono_font_buffer = NULL; continue;
+            }
+            fclose(fp);
+            if (stbtt_InitFont(&mono_font_info, mono_font_buffer,
+                               stbtt_GetFontOffsetForIndex(mono_font_buffer, 0))) {
+                mono_font_loaded = 1;
+                return 1;
+            }
+            free(mono_font_buffer); mono_font_buffer = NULL;
+        }
+    }
+    return 0;
+}
+
+static float mono_scale_for(int percent) {
+    if (percent < 60) percent = 60;
+    if (percent > 140) percent = 140;
+    return stbtt_ScaleForPixelHeight(&mono_font_info,
+             FONT_SIZE * (float)percent / 100.0f);
+}
+
+int font_mono_char_width(int percent) {
+    int advance, bearing;
+    if (!load_mono_font()) return 10 * UI_SCALE / 100;
+    stbtt_GetCodepointHMetrics(&mono_font_info, 'M', &advance, &bearing);
+    (void)bearing;
+    advance = (int)(advance * mono_scale_for(percent) + 0.5f);
+    return advance > 0 ? advance : 1;
+}
+
+int font_mono_line_height(int percent) {
+    int ascent, descent, gap;
+    float scale;
+    if (!load_mono_font()) return 22 * UI_SCALE / 100;
+    scale = mono_scale_for(percent);
+    stbtt_GetFontVMetrics(&mono_font_info, &ascent, &descent, &gap);
+    (void)gap;
+    return (int)((ascent - descent) * scale + 3.0f);
+}
+
+void font_draw_mono_text(uint16_t *framebuffer, int screen_width, int screen_height,
+                         int x, int y, const char *text, uint16_t color,
+                         int percent) {
+    float scale;
+    int ascent, descent, gap, baseline, advance, bearing;
+    int start_x = x, char_width, line_height;
+    if (!framebuffer || !text || !load_mono_font()) return;
+    scale = mono_scale_for(percent);
+    stbtt_GetFontVMetrics(&mono_font_info, &ascent, &descent, &gap);
+    baseline = (int)(ascent * scale);
+    stbtt_GetCodepointHMetrics(&mono_font_info, 'M', &advance, &bearing);
+    (void)bearing; (void)gap;
+    char_width = (int)(advance * scale + 0.5f);
+    if (char_width < 1) char_width = 1;
+    line_height = (int)((ascent - descent) * scale + 3.0f);
+    while (*text) {
+        unsigned char c = (unsigned char)*text++;
+        if (c == '\n') { x = start_x; y += line_height; continue; }
+        if (c == '\t') { x += char_width * (4 - ((x - start_x) / char_width) % 4); continue; }
+        if (c < 32 || c > 126) c = '?';
+        int glyph = stbtt_FindGlyphIndex(&mono_font_info, c);
+        int width, height, xoff, yoff;
+        unsigned char *bitmap = stbtt_GetGlyphBitmap(&mono_font_info, 0, scale,
+                                                      glyph, &width, &height, &xoff, &yoff);
+        if (bitmap) {
+            for (int row = 0; row < height; row++) for (int col = 0; col < width; col++) {
+                unsigned alpha = bitmap[row * width + col];
+                int px = x + xoff + col, py = y + baseline + yoff + row;
+                if (!alpha || px < 0 || px >= screen_width || py < 0 || py >= screen_height) continue;
+                uint16_t *dst = &framebuffer[py * screen_width + px];
+                if (alpha == 255) *dst = color;
+                else {
+                    uint16_t bg = *dst;
+                    int fr=(color>>11)&31, fg=(color>>5)&63, fb=color&31;
+                    int br=(bg>>11)&31, bgc=(bg>>5)&63, bb=bg&31, ia=255-(int)alpha;
+                    *dst=(uint16_t)((((fr*(int)alpha+br*ia)/255)<<11)|
+                                    (((fg*(int)alpha+bgc*ia)/255)<<5)|
+                                     ((fb*(int)alpha+bb*ia)/255));
+                }
+            }
+            stbtt_FreeBitmap(bitmap, NULL);
+        }
+        x += char_width;
+    }
+}
