+static void directory_lock_prompt_open(const char *path) {
+    int index = directory_lock_index_for_path(path);
+    if (index < 0) return;
+    snprintf(directory_lock_prompt_path, sizeof(directory_lock_prompt_path),
+             "%s", locked_directories[index]);
+    directory_lock_sequence_index = 0;
+    directory_lock_prompt_active = true;
+    ui_rendered_once = 0;
+}
