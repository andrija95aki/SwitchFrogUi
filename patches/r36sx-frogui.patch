+static void editor_handle_prompt_keyboard(void) {
+    int code, value;
+    io_keyboard_test_poll();
+    while (io_keyboard_pop_event(&code, &value)) {
+        int ch;
+        if (!value) continue;
+        if (code == KEY_ENTER || code == KEY_KPENTER) { editor_finish_prompt(); return; }
+        if (code == KEY_ESC) { editor_prompt_active = false; return; }
+        if (io_keyboard_ctrl_held() && code == KEY_A) {
+            editor_prompt_len=editor_prompt_cursor=0; editor_prompt_text[0]='\0';
+        } else if (code == KEY_LEFT && editor_prompt_cursor>0) editor_prompt_cursor--;
+        else if (code == KEY_RIGHT && editor_prompt_cursor<editor_prompt_len) editor_prompt_cursor++;
+        else if (code == KEY_HOME) editor_prompt_cursor=0;
+        else if (code == KEY_END) editor_prompt_cursor=editor_prompt_len;
+        else if (code == KEY_BACKSPACE && editor_prompt_cursor > 0) {
+            memmove(editor_prompt_text+editor_prompt_cursor-1,editor_prompt_text+editor_prompt_cursor,
+                    (size_t)(editor_prompt_len-editor_prompt_cursor+1));
+            editor_prompt_cursor--; editor_prompt_len--;
+        } else if (code == KEY_DELETE && editor_prompt_cursor<editor_prompt_len) {
+            memmove(editor_prompt_text+editor_prompt_cursor,editor_prompt_text+editor_prompt_cursor+1,
+                    (size_t)(editor_prompt_len-editor_prompt_cursor));
+            editor_prompt_len--;
+        }
+        else if (!io_keyboard_ctrl_held() &&
+                 (ch = io_keyboard_key_to_ascii(code, io_keyboard_shift_held())) >= 32 &&
+                 editor_prompt_len < EDITOR_NAME_CAP - 1) {
+            memmove(editor_prompt_text+editor_prompt_cursor+1,editor_prompt_text+editor_prompt_cursor,
+                    (size_t)(editor_prompt_len-editor_prompt_cursor+1));
+            editor_prompt_text[editor_prompt_cursor++]=(char)ch; editor_prompt_len++;
+        }
+    }
+}
+
+static void editor_handle_keyboard(void) {
+    int code, value;
+    io_keyboard_test_poll();
+    while (io_keyboard_pop_event(&code, &value)) {
+        int ch, ctrl, shift;
+        size_t start, end;
+        if (!value) continue;
+        ctrl = io_keyboard_ctrl_held(); shift = io_keyboard_shift_held();
+        if (ctrl && code == KEY_S) { editor_save(); continue; }
+        if (ctrl && code == KEY_A) {
+            editor_selection_anchor = 0; editor_cursor = editor_length; continue;
+        }
+        if (ctrl && code == KEY_C) { editor_copy_selection(); continue; }
+        if (ctrl && code == KEY_X) { editor_cut_selection(); continue; }
+        if (ctrl && code == KEY_V) { editor_paste(); continue; }
+        if (ctrl && code == KEY_Z) {
+            if (shift) editor_history_restore(editor_redo,&editor_redo_count,editor_undo,&editor_undo_count);
+            else editor_history_restore(editor_undo,&editor_undo_count,editor_redo,&editor_redo_count);
+            continue;
+        }
+        if (ctrl && code == KEY_Y) {
+            editor_history_restore(editor_redo,&editor_redo_count,editor_undo,&editor_undo_count); continue;
+        }
+        if (ctrl && code == KEY_F) { editor_begin_prompt(EDITOR_PROMPT_FIND); return; }
+        if (ctrl && code == KEY_N) {
+            if (editor_dirty) editor_save();
+            editor_begin_prompt(EDITOR_PROMPT_CREATE); return;
+        }
+        if (ctrl && code == KEY_O) {
+            if (editor_dirty) editor_save();
+            text_editor_active=false; scan_directory(current_path); editor_keyboard_drain(); return;
+        }
+        if (code == KEY_F2) { editor_begin_prompt(EDITOR_PROMPT_RENAME); return; }
+        if (code == KEY_F3) { editor_find_next(editor_last_find); continue; }
+
+        if (code == KEY_LEFT) {
+            if (!shift && editor_has_selection()) {
+                editor_selection_bounds(&start,&end); editor_cursor=start;
+            } else editor_cursor = ctrl ? editor_word_left(editor_cursor) :
+                                          (editor_cursor ? editor_cursor-1 : 0);
+            if (!shift) editor_selection_anchor=editor_cursor;
+        } else if (code == KEY_RIGHT) {
+            if (!shift && editor_has_selection()) {
+                editor_selection_bounds(&start,&end); editor_cursor=end;
+            } else editor_cursor = ctrl ? editor_word_right(editor_cursor) :
+                                          (editor_cursor<editor_length?editor_cursor+1:editor_length);
+            if (!shift) editor_selection_anchor=editor_cursor;
+        } else if (code == KEY_UP || code == KEY_DOWN || code == KEY_PAGEUP || code == KEY_PAGEDOWN) {
+            int direction=(code==KEY_UP||code==KEY_PAGEUP)?-1:1;
+            int count=(code==KEY_PAGEUP||code==KEY_PAGEDOWN)
+                      ? (SCREEN_HEIGHT-UI_S(104))/font_mono_line_height(95) : 1;
+            for(int i=0;i<count;i++) editor_move_vertical(direction);
+            if (!shift) editor_selection_anchor=editor_cursor;
+        } else if (code == KEY_HOME) {
+            editor_cursor = ctrl ? 0 : editor_line_start(editor_cursor);
+            if (!shift) editor_selection_anchor=editor_cursor;
+        } else if (code == KEY_END) {
+            editor_cursor = ctrl ? editor_length : editor_line_end(editor_cursor);
+            if (!shift) editor_selection_anchor=editor_cursor;
+        } else if (code == KEY_BACKSPACE) {
+            if (!editor_has_selection() && editor_cursor>0) {
+                editor_selection_anchor=editor_cursor;
+                editor_cursor=ctrl?editor_word_left(editor_cursor):editor_cursor-1;
+            }
+            if (editor_has_selection()) editor_replace_selection(NULL,0);
+        } else if (code == KEY_DELETE) {
+            if (!editor_has_selection() && editor_cursor<editor_length) {
+                editor_selection_anchor=ctrl?editor_word_right(editor_cursor):editor_cursor+1;
+            }
+            if (editor_has_selection()) editor_replace_selection(NULL,0);
+        } else if (code == KEY_ENTER || code == KEY_KPENTER) editor_insert_char('\n');
+        else if (code == KEY_TAB && shift) {
+            size_t line=editor_line_start(editor_cursor), remove=0;
+            while(remove<4 && line+remove<editor_length && editor_text[line+remove]==' ') remove++;
+            if(remove) { editor_cursor=line; editor_selection_anchor=line+remove; editor_replace_selection(NULL,0); }
+        } else if (code == KEY_TAB) editor_replace_selection("    ",4);
+        else if (code != KEY_ESC && !ctrl &&
+                 (ch = io_keyboard_key_to_ascii(code, shift)) >= 32)
+            editor_insert_char((char)ch);
+    }
+    editor_cursor_view_update();
+}
