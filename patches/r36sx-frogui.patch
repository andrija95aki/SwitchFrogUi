+        strcmp(entries[selected_index].name, EBOOKS_ENTRY_NAME) != 0 &&
+        strcmp(entries[selected_index].name, FILES_ENTRY_NAME) != 0 &&
+        strcmp(entries[selected_index].name, TERMINAL_ENTRY_NAME) != 0 &&
+        strcmp(entries[selected_index].name, EDITOR_ENTRY_NAME) != 0 &&
+        strcmp(entries[selected_index].name, JSDEV_ENTRY_NAME) != 0 &&
+        !viewing_files && !viewing_videos && !viewing_ebooks && !viewing_editor && !viewing_jsdev) {
+        const char *cur;
+        if (entries[selected_index].is_dir) {
+            snprintf(core_picker_key, sizeof(core_picker_key), "%s/%s",
+                     current_path, entries[selected_index].name);
+            snprintf(core_picker_title, sizeof(core_picker_title), "Folder: %s",
+                     entries[selected_index].name);
+            cur = core_override_lookup(NULL, core_picker_key);
+        } else {
+            snprintf(core_picker_key, sizeof(core_picker_key), "%s/%s",
+                     current_path, entries[selected_index].name);
+            snprintf(core_picker_title, sizeof(core_picker_title), "Game: %s",
+                     entries[selected_index].name);
+            cur = core_override_lookup(core_picker_key, NULL);
+        }
+        core_picker_idx = core_choice_index_for_path(cur);
+        core_picker_scroll = 0;
+        if (core_picker_idx >= VISIBLE_ENTRIES)
+            core_picker_scroll = core_picker_idx - VISIBLE_ENTRIES + 1;
+        core_picker_return_to_details = false;
+        core_picker_active = true;
+        return;
+    }
+
+    /* Y: toggle favourite for current ROM, or remove from favourites view */
+    if (input_was_pressed(FROG_BTN_Y) && selected_index < entry_count) {
+        if (viewing_favourites) {
+            /* Remove selected favourite */
+            favorites_remove_by_index(selected_index);
+            ui_notice("Removed from favourites");
+            /* Refresh favourites view */
+            const FavoriteGame *fl = favorites_get_list();
+            int fc = favorites_get_count();
+            entry_count = 0;
+            for (int i = 0; i < fc; i++) {
+                strncpy(entries[entry_count].name, fl[i].game_name, 255);
+                entries[entry_count].name[255] = '\0';
+                entries[entry_count].is_dir = 0;
+                entries[entry_count].home_recent_index = -1;
+                entry_count++;
+            }
+            if (selected_index >= entry_count && selected_index > 0)
+                selected_index = entry_count - 1;
+            if (entry_count == 0) {
+                /* No more favourites — go back to root */
+                viewing_favourites = false;
+                scan_directory(ROMS_PATH);
+                strncpy(current_path, ROMS_PATH, MAX_PATH_LEN-1);
+            }
+        } else if (!viewing_recents && !viewing_videos && !viewing_ebooks && !viewing_editor && !viewing_jsdev &&
+                   entries[selected_index].home_recent_index < 0 &&
+                   !entries[selected_index].is_dir &&
+                   strcmp(entries[selected_index].name, SETTINGS_ENTRY_NAME) != 0 &&
+                   strcmp(entries[selected_index].name, RECENTS_ENTRY_NAME) != 0 &&
+                   strcmp(entries[selected_index].name, FAVOURITES_ENTRY_NAME) != 0) {
+            /* Toggle favourite for current ROM */
+            const char *folder = get_console_folder(current_path);
+            const char *core   = get_core_for_folder(folder);
+            if (!core) core = get_core_for_extension(entries[selected_index].name);
+            if (is_ps1_folder(folder) && access(PCSX4ALL_BIN, F_OK) == 0)
+                core = PCSX4ALL_BIN;
+            char rom_path[MAX_PATH_LEN];
+            snprintf(rom_path, sizeof(rom_path), "%s/%s", current_path, entries[selected_index].name);
+            char game_name[256];
+            const char *display_name = strrchr(entries[selected_index].name, '/');
+            display_name = display_name ? display_name + 1 : entries[selected_index].name;
+            strncpy(game_name, display_name, sizeof(game_name)-1);
+            game_name[sizeof(game_name)-1] = '\0';
+            char *dot = strrchr(game_name, '.');
+            if (dot) *dot = '\0';
+            if (core) {
+                int was_favourite=favorites_is_path_favorited(rom_path);
+                favorites_toggle(core, game_name, rom_path);
+                ui_notice(was_favourite ? "Removed from favourites" : "Added to favourites");
+            }
+        }
+    }
+
+    if (input_was_pressed(FROG_BTN_A) && selected_index < entry_count) {
+        if(is_launcher_view()) home_selection_save(selected_index);
+        if (is_launcher_view() && entries[selected_index].home_recent_index >= 0) {
+            int ri = entries[selected_index].home_recent_index;
+            const RecentGame *recent = recent_games_get_list();
+            if (ri < recent_games_get_count()) {
+                request_saved_launch(recent[ri].core_name, recent[ri].full_path);
+            }
+        } else if (enter_selected_home_platform()) {
+            /* Platform probe opened the flat artwork grid. */
+        } else if (viewing_search) {
+            search_launch(selected_index);
+        } else if (viewing_favourites) {
+            /* Launch from favourites list */
+            const FavoriteGame *fl = favorites_get_list();
+            int fc = favorites_get_count();
+            if (selected_index < fc) {
+                request_saved_launch(fl[selected_index].core_name,
+                                     fl[selected_index].full_path);
+            }
+        } else if (viewing_recents) {
+            /* Launch from recent games list */
+            const RecentGame *rg = recent_games_get_list();
+            int rc = recent_games_get_count();
+            if (selected_index < rc) {
+                request_saved_launch(rg[selected_index].core_name,
+                                     rg[selected_index].full_path);
+            }
+        } else if (is_launcher_view() && strcmp(entries[selected_index].name, MUSIC_ENTRY_NAME) == 0) {
+            request_utility_launch(ROCKBOX_BIN, SDCARD_BASE);
+        } else if (is_launcher_view() && strcmp(entries[selected_index].name, VIDEOS_ENTRY_NAME) == 0) {
+            viewing_videos = true;
+            browser_history_clear();
+            banner_clear();
+            strncpy(current_path, SDCARD_BASE, MAX_PATH_LEN - 1);
+            current_path[MAX_PATH_LEN - 1] = '\0';
+            scan_directory(current_path);
+        } else if (is_launcher_view() && strcmp(entries[selected_index].name, EBOOKS_ENTRY_NAME) == 0) {
+            viewing_ebooks = true;
+            browser_history_clear();
+            banner_clear();
+            strncpy(current_path,SDCARD_BASE,MAX_PATH_LEN-1);
+            current_path[MAX_PATH_LEN-1]='\0';
+            scan_directory(current_path);
+        } else if (is_launcher_view() && strcmp(entries[selected_index].name, FILES_ENTRY_NAME) == 0) {
+            viewing_files = true;
+            browser_history_clear();
+            file_selected_count = 0;
+            banner_clear();
+            strncpy(current_path, SDCARD_BASE, MAX_PATH_LEN - 1);
+            current_path[MAX_PATH_LEN - 1] = '\0';
+            scan_directory(current_path);
+            io_keyboard_test_start(); editor_keyboard_drain();
+        } else if (is_launcher_view() && strcmp(entries[selected_index].name, TERMINAL_ENTRY_NAME) == 0) {
+            terminal_start();
+        } else if (is_launcher_view() && strcmp(entries[selected_index].name, EDITOR_ENTRY_NAME) == 0) {
+            viewing_editor=true;
+            browser_history_clear();
+            banner_clear();
+            strncpy(current_path,SDCARD_BASE,MAX_PATH_LEN-1);
+            current_path[MAX_PATH_LEN-1]='\0';
+            scan_directory(current_path);
+            io_keyboard_test_start(); editor_keyboard_drain();
+        } else if (is_launcher_view() && strcmp(entries[selected_index].name, JSDEV_ENTRY_NAME) == 0) {
+            mkdir_p(JSDEV_ROOT);
+            viewing_jsdev=true;
+            browser_history_clear();
+            banner_clear();
+            strncpy(current_path,SDCARD_BASE,MAX_PATH_LEN-1);
+            current_path[MAX_PATH_LEN-1]='\0';
+            scan_directory(current_path);
+            io_keyboard_test_start(); editor_keyboard_drain();
+        } else if (is_launcher_view() && strcmp(entries[selected_index].name, FAVOURITES_ENTRY_NAME) == 0) {
+            /* Enter favourites view */
+            const FavoriteGame *fl = favorites_get_list();
+            int fc = favorites_get_count();
+            while (fc > entry_capacity) {
+                entry_capacity = entry_capacity ? entry_capacity*2 : INITIAL_ENTRIES_CAPACITY;
+                entries = realloc(entries, entry_capacity * sizeof(DirEntry));
+                if (!entries) goto input_done;
+            }
+            entry_count = 0;
+            for (int i = 0; i < fc; i++) {
+                strncpy(entries[entry_count].name, fl[i].game_name, 255);
+                entries[entry_count].name[255] = '\0';
+                entries[entry_count].is_dir = 0;
+                entries[entry_count].home_recent_index = -1;
+                entry_count++;
+            }
+            viewing_favourites = true;
+            selected_index = 0; scroll_offset = 0;
+        } else if (is_launcher_view() && strcmp(entries[selected_index].name, RECENTS_ENTRY_NAME) == 0) {
+            enter_recents_view();
+        } else if (entries[selected_index].is_dir) {
+            char new_path[MAX_PATH_LEN];
+            snprintf(new_path, sizeof(new_path), "%s/%s", current_path, entries[selected_index].name);
+            if (directory_lock_index_for_path(new_path) >= 0) {
+                directory_lock_prompt_open(new_path);
+                goto input_done;
+            }
+            if (is_utility_browser()) browser_history_push();
+            strncpy(current_path, new_path, MAX_PATH_LEN-1);
+            current_path[MAX_PATH_LEN-1] = '\0';
+            if (viewing_files) file_selected_count = 0;
+            scan_directory(current_path);
+        } else {
+            if (strcmp(entries[selected_index].name, SETTINGS_ENTRY_NAME) == 0) {
+                settings_menu_active = true;
+                settings_menu_idx = 0;
+                settings_filter_idx_on_enter = settings_filter_idx;
+            } else if (viewing_jsdev) {
+                char file_path[MAX_PATH_LEN];
+                snprintf(file_path, sizeof(file_path), "%s/%s", current_path,
+                         entries[selected_index].name);
+                request_game_launch(JSDEV_CORE, file_path);
+            } else if (viewing_editor) {
+                char file_path[MAX_PATH_LEN];
+                snprintf(file_path, sizeof(file_path), "%s/%s", current_path,
+                         entries[selected_index].name);
+                editor_open_file(file_path);
+            } else if (viewing_files || viewing_videos || viewing_ebooks) {
+                char file_path[MAX_PATH_LEN];
+                snprintf(file_path, sizeof(file_path), "%s/%s", current_path,
+                         entries[selected_index].name);
+                if (is_video_file(entries[selected_index].name)) {
+                    utility_return_save();
+                    request_utility_launch(VIDEO_BIN, file_path);
+                } else if (viewing_ebooks && is_ebook_file(entries[selected_index].name))
+                    request_utility_launch(EBOOK_BIN,file_path);
+                else if (viewing_files && is_image_file(entries[selected_index].name))
+                    photo_viewer_open(file_path);
+                else if (viewing_files && is_audio_file(entries[selected_index].name))
+                    request_utility_launch(ROCKBOX_BIN, file_path);
+                else if (viewing_files && is_text_file(entries[selected_index].name)) {
+                    io_keyboard_test_start(); editor_keyboard_drain();
+                    editor_open_file(file_path);
+                }
+                else
+                    dbg("file browser: no application for selected file");
+            } else {
+                const char *folder = get_console_folder(current_path);
+                char rom_path[MAX_PATH_LEN];
+                snprintf(rom_path, sizeof(rom_path), "%s/%s", current_path, entries[selected_index].name);
+                /* per-game / per-folder override wins over folder/extension default */
+                const char *ov = core_override_lookup(rom_path, current_path);
+                const char *core = ov ? ov : get_core_for_folder(folder);
+                if (!core)
+                    core = get_core_for_extension(entries[selected_index].name);
+                if (ov) {
+                    request_game_launch(ov, rom_path);   /* override → always libretro */
+                } else if (core) {
+                    if (is_ps1_folder(folder) && access(PCSX4ALL_BIN, F_OK) == 0)
+                        request_standalone_launch(PCSX4ALL_BIN, rom_path);
+                    else if (is_standalone_bin(core) && access(core, F_OK) == 0)
+                        request_standalone_launch(core, rom_path);
+                    else
+                        request_game_launch(core, rom_path);
+                } else {
+                    dbg("no core mapping for this folder or extension");
+                }
+            }
+        }
+    }
+
+    if (input_was_pressed(FROG_BTN_B)) {
+        if (viewing_search) {
+            /* back to the keyboard to refine the query */
+            viewing_search = false;
+            io_keyboard_test_start();
+            io_keyboard_discard_events();
+            virtual_keyboard_prepare();
+            search_kbd_active = true;
+        } else if (viewing_recents || viewing_favourites) {
+            viewing_recents = false;
+            viewing_favourites = false;
+            scan_directory(ROMS_PATH);
+            strncpy(current_path, ROMS_PATH, MAX_PATH_LEN-1);
+            selected_index=min(home_selected_index,entry_count>0?entry_count-1:0);
+        } else if (is_utility_browser()) {
+            utility_browser_go_back();
+        } else if (strcmp(current_path, ROMS_PATH) != 0) {
+            char *slash = strrchr(current_path, '/');
+            if (slash) {
+                *slash = '\0'; scan_directory(current_path);
+                if(strcmp(current_path,ROMS_PATH)==0)
+                    selected_index=min(home_selected_index,entry_count>0?entry_count-1:0);
+            }
+        }
+    }
+
+    bool launcher = is_launcher_view();
+    bool cards = is_game_card_view();
+    int nav_count = viewing_favourites ? favorites_get_count() :
+                    (viewing_recents ? recent_games_get_count() : entry_count);
+    int card_page_size = compact_game_list ? (game_category_count > 1 ? 10 : 12) : 8;
+    if (cards && nav_count>0 && input_was_pressed(FROG_BTN_L1)) {
+        selected_index = selected_index >= card_page_size ? selected_index - card_page_size :
+                         ((nav_count-1)/card_page_size)*card_page_size;
+    }
+    if (cards && nav_count>0 && input_was_pressed(FROG_BTN_R1)) {
+        selected_index = selected_index + card_page_size < nav_count ?
+                         selected_index + card_page_size : 0;
+    }
+    if (nav_count>0 && input_was_pressed(FROG_BTN_UP)) {
+        selected_index = cards ? (compact_game_list ? (selected_index-1+nav_count)%nav_count :
+                                  (selected_index>=4 ? selected_index-4 : nav_count-1))
+                         : launcher ? (selected_index>=3 ? selected_index-3 : nav_count-1)
+                                    : (selected_index-1+nav_count)%nav_count;
+    }
+    if (nav_count>0 && input_was_pressed(FROG_BTN_DOWN)) {
+        selected_index = cards ? (compact_game_list ? (selected_index+1)%nav_count :
+                                  (selected_index+4<nav_count ? selected_index+4 : 0))
+                         : launcher ? (selected_index+3<nav_count ? selected_index+3 : 0)
+                                    : (selected_index+1)%nav_count;
+    }
+    /* In the game switcher (one game on screen at a time), Left/Right step one
+     * game like Up/Down — no page jumping. */
+    bool switcher = viewing_recents && settings_game_switcher;
+    if (nav_count>0 && input_was_pressed(FROG_BTN_LEFT)) {
+        if (cards) {
+            selected_index=(selected_index-1+nav_count)%nav_count;
+        } else if (launcher) {
+            selected_index=(selected_index-1+nav_count)%nav_count;
+        } else if (switcher) {
+            selected_index=(selected_index-1+nav_count)%nav_count;
+        } else {
+            selected_index = (selected_index >= VISIBLE_ENTRIES) ? selected_index - VISIBLE_ENTRIES : nav_count-1;
+        }
+    }
+    if (nav_count>0 && input_was_pressed(FROG_BTN_RIGHT)) {
+        if (cards) {
+            selected_index=(selected_index+1)%nav_count;
+        } else if (launcher) {
+            selected_index=(selected_index+1)%nav_count;
+        } else if (switcher) {
+            selected_index=(selected_index+1)%nav_count;
+        } else {
+            selected_index = (selected_index + VISIBLE_ENTRIES < nav_count) ? selected_index + VISIBLE_ENTRIES : 0;
+        }
+    }
+    if(selected_index<scroll_offset) scroll_offset=selected_index;
+    if(selected_index>=scroll_offset+VISIBLE_ENTRIES)
+        scroll_offset=selected_index-VISIBLE_ENTRIES+1;
+
+input_done:;
+}
+
+static void ui_sound_trigger(int pitch) {
+    ui_sound_frames = 2205; /* 50 ms at 44.1 kHz */
+    ui_sound_phase = (unsigned)(pitch < 1 ? 900 : pitch);
+}
+
+static void ui_sound_play(int event) {
+    if(settings_sound_pack==0) return;
+    if(event<0 || event>2) event=0;
+    if(settings_sound_pack==1) {
+        static const int pitch[3]={1250,900,650};
+        ui_clip_playing=NULL; ui_sound_trigger(pitch[event]); return;
+    }
+    ui_sound_load_pack();
+    if(ui_clips[event].samples && ui_clips[event].frames>0) {
+        ui_sound_frames=0; ui_clip_playing=ui_clips[event].samples;
+        ui_clip_frames=ui_clips[event].frames; ui_clip_pos=0;
+    } else {
+        ui_sound_trigger(event==0?1250:(event==1?900:650));
+    }
+}
+
+static void ui_audio_render(void) {
+    if (!audio_batch_cb && !audio_cb) return;
+    static const int16_t silence[735 * 2] = {0};
+    if (ui_sound_frames <= 0 && (!ui_clip_playing || ui_clip_pos>=ui_clip_frames)) {
+        if (audio_batch_cb) audio_batch_cb(silence, 735);
+        else for (int i = 0; i < 735; i++) audio_cb(0, 0);
+        return;
+    }
+    int16_t samples[735 * 2];
+    unsigned step = ui_sound_phase ? ui_sound_phase : 900;
+    static unsigned phase = 0;
+    for (int i = 0; i < 735; i++) {
+        int16_t v = 0;
+        if(ui_clip_playing && ui_clip_pos<ui_clip_frames) {
+            int sample=ui_clip_playing[ui_clip_pos++];
+            v=(int16_t)(sample*volume_output_gain(settings_volume)/100);
+            if(ui_clip_pos>=ui_clip_frames) ui_clip_playing=NULL;
+        } else if (ui_sound_frames > 0) {
+            phase += step;
+            int amp = 1100 * ui_sound_frames / 2205;
+            amp = amp * volume_output_gain(settings_volume) / 100;
+            v = (phase % 44100u) < 22050u ? (int16_t)amp : (int16_t)-amp;
+            ui_sound_frames--;
+        }
+        samples[i * 2] = samples[i * 2 + 1] = v;
+    }
+    if (audio_batch_cb) audio_batch_cb(samples, 735);
+    else for (int i = 0; i < 735; i++) audio_cb(samples[i * 2], samples[i * 2 + 1]);
+}
