+static uint16_t ui_mix565(uint16_t a, uint16_t b, int amount) {
+    int ar=(a>>11)&31, ag=(a>>5)&63, ab=a&31;
+    int br=(b>>11)&31, bg=(b>>5)&63, bb=b&31;
+    int r=(ar*(255-amount)+br*amount)/255;
+    int g=(ag*(255-amount)+bg*amount)/255;
+    int bl=(ab*(255-amount)+bb*amount)/255;
+    return (uint16_t)((r<<11)|(g<<5)|bl);
+}
+
+static void render_modern_row(const char *label, const char *value, int y, int selected) {
+    int x = PADDING, w = SCREEN_WIDTH - PADDING * 2, h = UI_S(28);
+    uint16_t bg = selected ? COLOR_SELECT_BG : ui_mix565(COLOR_BG, COLOR_TEXT, 20);
+    if (selected)
+        render_rounded_rect(framebuffer, x - UI_S(2), y - UI_S(2),
+                            w + UI_S(4), h + UI_S(4), UI_S(8), COLOR_TEXT);
+    render_rounded_rect(framebuffer, x, y, w, h, UI_S(7), bg);
+    font_draw_text(framebuffer, SCREEN_WIDTH, SCREEN_HEIGHT, x + UI_S(10),
+                   y + UI_S(8), label, selected ? COLOR_SELECT_TEXT : COLOR_TEXT);
+    if (value && *value) {
+        int tw = (int)strlen(value) * UI_S(8);
+        font_draw_text(framebuffer, SCREEN_WIDTH, SCREEN_HEIGHT,
+                       x + w - tw - UI_S(10), y + UI_S(8), value,
+                       selected ? COLOR_SELECT_TEXT : COLOR_LEGEND);
+    }
+}
