+/* v1.0.12-style position hint for lists longer than their viewport. */
+static void render_scroll_indicator(int total, int first, int visible, int y, int height) {
+    if (total <= visible || visible <= 0 || height < UI_S(12)) return;
+    int x=SCREEN_WIDTH-UI_S(8), track_w=UI_S(3);
+    int thumb_h=height*visible/total;
+    if(thumb_h<UI_S(12)) thumb_h=UI_S(12);
+    if(thumb_h>height) thumb_h=height;
+    int travel=height-thumb_h, denom=total-visible;
+    int thumb_y=y+(denom>0 ? travel*first/denom : 0);
+    render_rounded_rect(framebuffer,x,y,track_w,height,track_w/2,
+                        ui_mix565(COLOR_BG,COLOR_TEXT,35));
+    render_rounded_rect(framebuffer,x,thumb_y,track_w,thumb_h,track_w/2,COLOR_TEXT);
+}
