+/* Standalone applications restart FrogUI when they exit.  Remember the
+ * browser by directory and entry name (rather than by a fragile numeric
+ * index) so normal end-of-video and manual exit both return to the exact file
+ * that launched the player. */
+static void utility_return_save(void) {
+    if ((!viewing_videos && !viewing_files) || selected_index < 0 ||
+        selected_index >= entry_count)
+        return;
+    FILE *file = fopen(UTILITY_RETURN_TMP, "wb");
+    if (!file) return;
+    fprintf(file, "mode=%s\npath=%s\nentry=%s\n",
+            viewing_videos ? "videos" : "files", current_path,
+            entries[selected_index].name);
+    fflush(file);
+    fsync(fileno(file));
+    fclose(file);
+    rename(UTILITY_RETURN_TMP, UTILITY_RETURN_FILE);
+}
+
+static bool utility_return_restore(void) {
+    char line[MAX_PATH_LEN + 16];
+    char mode[16] = "";
+    char path[MAX_PATH_LEN] = "";
+    char entry[256] = "";
+    FILE *file = fopen(UTILITY_RETURN_FILE, "rb");
+    if (!file) return false;
+    while (fgets(line, sizeof(line), file)) {
+        line[strcspn(line, "\r\n")] = '\0';
+        if (!strncmp(line, "mode=", 5)) {
+            strncpy(mode, line + 5, sizeof(mode) - 1);
+            mode[sizeof(mode) - 1] = '\0';
+        } else if (!strncmp(line, "path=", 5)) {
+            strncpy(path, line + 5, sizeof(path) - 1);
+            path[sizeof(path) - 1] = '\0';
+        } else if (!strncmp(line, "entry=", 6)) {
+            strncpy(entry, line + 6, sizeof(entry) - 1);
+            entry[sizeof(entry) - 1] = '\0';
+        }
+    }
+    fclose(file);
+    unlink(UTILITY_RETURN_FILE); /* consume once; a reboot cannot trap the UI */
+
+    size_t root_len = strlen(SDCARD_BASE);
+    /* Accept the temporary 1.3.1 TreeVidPlay browser mode once so an update
+     * returns to the same file; all future saves use the single Videos mode. */
+    bool legacy_treevid = !strcmp(mode, "treevidplay");
+    bool valid_mode = legacy_treevid || !strcmp(mode, "videos") || !strcmp(mode, "files");
+    bool valid_path = !strcmp(path, SDCARD_BASE) ||
+                      (!strncmp(path, SDCARD_BASE, root_len) &&
+                       path[root_len] == '/');
+    if (valid_path && directory_lock_index_for_path(path) >= 0) valid_path = false;
+    DIR *directory = valid_path ? opendir(path) : NULL;
+    if (!valid_mode || !directory) {
+        if (directory) closedir(directory);
+        dbg("utility return: discarded invalid browser state");
+        return false;
+    }
+    closedir(directory);
+
+    viewing_files = !strcmp(mode, "files");
+    viewing_videos = legacy_treevid || !strcmp(mode, "videos");
+    viewing_ebooks = viewing_editor = viewing_jsdev = false;
+    strncpy(current_path, path, MAX_PATH_LEN - 1);
+    current_path[MAX_PATH_LEN - 1] = '\0';
+    scan_directory(current_path);
+    browser_history_clear();
+    browser_select_name(entry);
+    if (viewing_files) {
+        file_selected_count = 0;
+        io_keyboard_test_start();
+        editor_keyboard_drain();
+    }
+    dbg("utility return: restored video browser selection");
+    return true;
+}
