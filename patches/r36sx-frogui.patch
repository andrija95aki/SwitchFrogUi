+        case KEY_R: return "R"; case KEY_T: return "T"; case KEY_Y: return "Y";
+        case KEY_U: return "U"; case KEY_I: return "I"; case KEY_O: return "O";
+        case KEY_P: return "P"; case KEY_LEFTBRACE: return "["; case KEY_RIGHTBRACE: return "]";
