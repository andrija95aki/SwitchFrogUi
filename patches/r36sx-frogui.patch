+
+static void thumbnail_owned_free(Thumbnail *t) {
+    if(!t) return;
+    free(t->data); free((void *)t->alpha);
+    memset(t,0,sizeof(*t));
+}
+
+static int thumbnail_owned_load(const char *base, Thumbnail *out) {
+    Thumbnail tmp={0};
+    if(!load_thumbnail(base,&tmp) || !tmp.data) return 0;
+    size_t pixels=(size_t)tmp.width*tmp.height;
+    out->data=malloc(pixels*sizeof(uint16_t));
+    if(!out->data) return 0;
+    memcpy(out->data,tmp.data,pixels*sizeof(uint16_t));
+    out->alpha=NULL;
+    if(tmp.alpha) {
+        uint8_t *alpha=malloc(pixels);
+        if(alpha){memcpy(alpha,tmp.alpha,pixels);out->alpha=alpha;}
+    }
+    out->width=tmp.width; out->height=tmp.height;
+    return 1;
+}
+
+static int thumbnail_owned_load_game(const char *game_path, Thumbnail *out) {
+    Thumbnail tmp={0};
+    if(!load_game_thumbnail(game_path,ROMS_PATH,&tmp) || !tmp.data) return 0;
+    size_t pixels=(size_t)tmp.width*tmp.height;
+    out->data=malloc(pixels*sizeof(uint16_t));
+    if(!out->data) return 0;
+    memcpy(out->data,tmp.data,pixels*sizeof(uint16_t));
+    out->alpha=NULL;
+    if(tmp.alpha) {
+        uint8_t *alpha=malloc(pixels);
+        if(alpha){memcpy(alpha,tmp.alpha,pixels);out->alpha=alpha;}
+    }
+    out->width=tmp.width; out->height=tmp.height;
+    return 1;
+}
+
+/* Sample at most roughly 1K pixels. This runs only when an artwork cache slot
+ * changes, so selection glow does not add measurable work to steady frames. */
+static uint16_t thumbnail_average_color(const Thumbnail *t) {
+    if(!t || !t->data || t->width<=0 || t->height<=0) return COLOR_SELECT_BG;
+    size_t pixels=(size_t)t->width*t->height;
+    size_t step=pixels/1024; if(step<1) step=1;
+    uint32_t rs=0,gs=0,bs=0,count=0;
+    for(size_t i=0;i<pixels;i+=step) {
+        if(t->alpha && t->alpha[i]<64) continue;
+        uint16_t p=t->data[i];
+        rs+=(p>>11)&31; gs+=(p>>5)&63; bs+=p&31; count++;
+    }
+    if(!count) return COLOR_SELECT_BG;
+    return (uint16_t)(((rs/count)<<11)|((gs/count)<<5)|(bs/count));
+}
+
+static Thumbnail *launcher_get_art(int slot, int index) {
+    LauncherArt *a=&launcher_art[slot];
+    const char *name=(index>=0 && index<entry_count)?entries[index].name:"";
+    if(a->index==index && !strcmp(a->name,name)) return a->thumb.data?&a->thumb:NULL;
+    if(a->thumb.data) thumbnail_owned_free(&a->thumb);
+    memset(&a->thumb,0,sizeof(a->thumb)); a->index=index; a->average_valid=0;
+    strncpy(a->name,name,sizeof(a->name)-1); a->name[sizeof(a->name)-1]='\0';
+    if(index<0 || index>=entry_count) return NULL;
+    if(entries[index].home_recent_index >= 0) {
+        int ri=entries[index].home_recent_index;
+        const RecentGame *recent=recent_games_get_list();
+        if(ri<recent_games_get_count() &&
+           thumbnail_owned_load_game(recent[ri].full_path,&a->thumb)) {
+            a->average_color=thumbnail_average_color(&a->thumb); a->average_valid=1;
+            return &a->thumb;
+        }
+        return NULL;
+    }
+    if(!entries[index].is_dir) return NULL;
+    char path[MAX_PATH_LEN];
+    const char *asset=entries[index].name;
+    if(!strcasecmp(asset,"MD") || !strcasecmp(asset,"SMS")) asset="sega";
+    snprintf(path,sizeof(path),SDCARD_BASE "/frogui/%s",asset);
+    if(thumbnail_owned_load(path,&a->thumb)) {
+        a->average_color=thumbnail_average_color(&a->thumb); a->average_valid=1;
+        return &a->thumb;
+    }
+    return NULL;
+}
