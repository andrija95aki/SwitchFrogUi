+}
+
+int load_game_thumbnail(const char *game_path, const char *roms_root, Thumbnail *thumb) {
+    if (!game_path || !*game_path || !roms_root || !*roms_root || !thumb) return 0;
+
+    const char *slash = strrchr(game_path, '/');
+    if (!slash || !slash[1]) return 0;
+
+    char base[256];
+    strncpy(base, slash + 1, sizeof(base) - 1);
+    base[sizeof(base) - 1] = '\0';
+    char *dot = strrchr(base, '.');
+    if (dot) *dot = '\0';
+
+    char immediate[1024];
+    size_t immediate_len = (size_t)(slash - game_path);
+    if (immediate_len >= sizeof(immediate)) return 0;
+    memcpy(immediate, game_path, immediate_len);
+    immediate[immediate_len] = '\0';
+    if (load_art_from_dir(immediate, base, thumb)) return 1;
+
+    /* Nested collections such as ROMs inside roms/gb/GB commonly keep artwork
+     * one level up in roms/gb/images/. */
+    size_t root_len = strlen(roms_root);
+    if (strncmp(game_path, roms_root, root_len) == 0 && game_path[root_len] == '/') {
+        const char *platform = game_path + root_len + 1;
+        const char *platform_end = strchr(platform, '/');
+        if (platform_end) {
+            char platform_root[1024];
+            size_t platform_len = (size_t)(platform_end - game_path);
+            if (platform_len < sizeof(platform_root)) {
+                memcpy(platform_root, game_path, platform_len);
+                platform_root[platform_len] = '\0';
+                if (strcmp(platform_root, immediate) != 0 &&
+                    load_art_from_dir(platform_root, base, thumb)) return 1;
+            }
+        }
+    }
+    return 0;
+}
