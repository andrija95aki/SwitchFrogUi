+static void render_compact_game_list(void) {
+    const int visible = 12;
+    int count = viewing_favourites ? favorites_get_count() : entry_count;
+    if (selected_index < 0) selected_index = 0;
+    if (selected_index >= count && count > 0) selected_index = count - 1;
+    int first = (selected_index / visible) * visible;
+    render_clear_screen(framebuffer);
+    char header[112];
+    if (viewing_search)
+        snprintf(header, sizeof(header), "SEARCH: %s (%d)", search_query, count);
+    else
+        snprintf(header, sizeof(header), "%s  -  LIST", viewing_favourites ? "FAVOURITES" : get_basename(current_path));
+    render_header(framebuffer, header);
+
+    const int row_h = UI_S(27), top = START_Y - UI_S(2);
+    for (int slot = 0; slot < visible; slot++) {
+        int idx = first + slot; if (idx >= count) break;
+        int y = top + slot * row_h;
+        bool selected = idx == selected_index;
+        if (selected)
+            render_rounded_rect_aa(framebuffer, PADDING, y, SCREEN_WIDTH - PADDING * 2,
+                                   row_h - UI_S(2), UI_S(5), COLOR_SELECT_BG);
+        char full[MAX_PATH_LEN]; if (!card_full_path(idx, full, sizeof(full))) continue;
+        char name[256]; game_display_name(full, name, sizeof(name));
+        char number[16]; snprintf(number, sizeof(number), "%d", idx + 1);
+        uint16_t fg = selected ? COLOR_SELECT_TEXT : COLOR_TEXT;
+        font_draw_text_scaled(framebuffer, SCREEN_WIDTH, SCREEN_HEIGHT,
+                              PADDING + UI_S(8), y + UI_S(6), number,
+                              selected ? COLOR_SELECT_TEXT : COLOR_DISABLED, 72);
+        int name_x = PADDING + UI_S(48);
+        int max_w = SCREEN_WIDTH - name_x - PADDING - UI_S(48);
+        bool cut = false;
+        while (strlen(name) > 3 && font_measure_text_scaled(name, 72) > max_w) {
+            name[strlen(name) - 1] = '\0'; cut = true;
+        }
+        if (cut && strlen(name) > 3) {
+            size_t n = strlen(name); name[n - 2] = '.'; name[n - 1] = '.';
+        }
+        font_draw_text_scaled(framebuffer, SCREEN_WIDTH, SCREEN_HEIGHT,
+                              name_x, y + UI_S(6), name, fg, 72);
+        if (path_is_favorite(full))
