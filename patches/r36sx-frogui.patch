+
+static void editor_history_restore(EditorSnapshot *from, int *from_count,
+                                   EditorSnapshot *to, int *to_count) {
+    EditorSnapshot snapshot;
+    if (*from_count <= 0 || !editor_buffer_ready()) return;
+    editor_history_push(to, to_count);
+    snapshot = from[--(*from_count)];
+    memcpy(editor_text, snapshot.text, snapshot.length + 1);
+    editor_length = snapshot.length;
+    editor_cursor = snapshot.cursor;
+    editor_selection_anchor = snapshot.anchor;
+    editor_dirty = snapshot.dirty;
+    free(snapshot.text);
+    editor_cursor_view_update();
+}
