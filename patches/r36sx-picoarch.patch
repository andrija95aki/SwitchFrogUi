+/*
+ * ALi framebuffer GMA scaler ABI.
+ *
+ * The public M36F PDK defines FBIO_SET_GMA_SCALE_INFO as 0x460022 and the
+ * parameter block below as eight 32-bit words.  GMA_RSZ_DIRECT_RESIZE selects
+ * the hardware "duplicate" scaler (point/nearest); GMA_RSZ_ALPHA_COLOR selects
+ * the normal filtered scaler.  Keep fixed-width fields here: the target is
+ * MIPS o32, while host-side syntax builds may have 64-bit unsigned long.
+ *
+ * Firmware variants can override the command with TF_GMA_SCALE_IOCTL (base 0
+ * numeric syntax, e.g. 0x460022), or disable this probe with
+ * TF_GMA_NEAREST=0.  An unsupported command simply returns ENOTTY and leaves
+ * the established software/bilinear fallback in place.
+ */
+#define ALIFB_FBIO_SET_GMA_SCALE_INFO 0x460022UL
+#define ALIFB_GMA_RSZ_DIRECT_RESIZE   4
+#define ALIFB_GMA_RSZ_ALPHA_COLOR     7
+#define ALIFB_GE_SET_SCALE_PARAM      5
+
+struct alifb_gma_scale_info {
+    int32_t  scale_mode;
+    int32_t  h_dst;
+    int32_t  h_src;
+    int32_t  v_dst;
+    int32_t  v_src;
+    int32_t  tv_sys;
+    uint32_t scale_cmd;
+    uint32_t scale_param;
+};
+typedef char alifb_gma_scale_info_must_be_32_bytes[
+    sizeof(struct alifb_gma_scale_info) == 32 ? 1 : -1
+];
+
+static int g_gma_probe = -1;       /* -1 unknown, 0 unavailable/disabled, 1 works */
+static int g_gma_mode = -1;        /* last accepted ALIFB_GMA_RSZ_* mode */
+static int g_gma_hsrc, g_gma_vsrc, g_gma_hdst, g_gma_vdst;
+
+static unsigned long hwdisp_gma_ioctl_number(void)
+{
+    const char *s = getenv("TF_GMA_SCALE_IOCTL");
+    char *end = NULL;
+    unsigned long cmd;
+
+    if (!s || !*s)
+        return ALIFB_FBIO_SET_GMA_SCALE_INFO;
+    errno = 0;
+    cmd = strtoul(s, &end, 0);
+    if (errno || end == s || *end || !cmd) {
+        DBG("DBG gma-scale: invalid TF_GMA_SCALE_IOCTL='%s', using 0x%lx\n",
+            s, ALIFB_FBIO_SET_GMA_SCALE_INFO);
+        return ALIFB_FBIO_SET_GMA_SCALE_INFO;
+    }
+    return cmd;
+}
+
+static int hwdisp_gma_enabled(void)
+{
+    const char *s = getenv("TF_GMA_NEAREST");
+    return !(s && (!strcmp(s, "0") || !strcasecmp(s, "off") ||
+                  !strcasecmp(s, "false")));
+}
+
+static int hwdisp_set_gma_nearest(int nearest)
+{
+    struct alifb_gma_scale_info p;
+    struct fb_var_screeninfo vi;
+    unsigned long cmd;
+    int fd, panel_w, panel_h, mode, saved_errno, rv;
+
+    if (!g_active)
+        return 0;
+    if (!hwdisp_gma_enabled()) {
+        if (g_gma_probe != 0)
+            DBG("DBG gma-scale: disabled by TF_GMA_NEAREST\n");
+        g_gma_probe = 0;
+        g_gma_mode = -1;
+        return 0;
+    }
+    /* A normal driver init already selects filtered mode. Do not probe merely
+     * to re-assert that default, and do not hammer an unsupported ioctl once
+     * per frame. A successful nearest probe changes g_gma_probe to 1, at which
+     * point the filtered call below is required to restore bilinear mode. */
+    if ((!nearest && g_gma_probe < 1) || g_gma_probe == 0)
+        return 0;
+
+    fd = open("/dev/fb0", O_RDWR);
+    if (fd < 0) {
+        if (g_gma_probe != 0)
+            DBG("DBG gma-scale: open fb0 failed errno=%d\n", errno);
+        g_gma_probe = 0;
+        return 0;
+    }
+    memset(&vi, 0, sizeof(vi));
+    if (ioctl(fd, FBIOGET_VSCREENINFO, &vi) < 0 ||
+        vi.xres == 0 || vi.yres == 0) {
+        saved_errno = errno;
+        close(fd);
+        if (g_gma_probe != 0)
+            DBG("DBG gma-scale: FBIOGET_VSCREENINFO failed errno=%d\n",
+                saved_errno);
+        g_gma_probe = 0;
+        return 0;
+    }
+
+    extern int sf3000_panel_w(void);
+    extern int sf3000_panel_h(void);
+    panel_w = sf3000_panel_w();
+    panel_h = sf3000_panel_h();
+    /*
+     * GMA coordinates follow the framebuffer orientation.  Most HW init paths
+     * expose a landscape 1280x720 fb, but older SF firmware can retain the
+     * portrait 720x1280 layout and rotate later in DE.
+     */
+    if ((vi.xres < vi.yres) != (panel_w < panel_h)) {
+        int t = panel_w;
+        panel_w = panel_h;
+        panel_h = t;
+    }
+
+    mode = nearest ? ALIFB_GMA_RSZ_DIRECT_RESIZE
+                   : ALIFB_GMA_RSZ_ALPHA_COLOR;
+    if (g_gma_probe == 1 && g_gma_mode == mode &&
+        g_gma_hsrc == (int)vi.xres && g_gma_vsrc == (int)vi.yres &&
+        g_gma_hdst == panel_w && g_gma_vdst == panel_h) {
+        close(fd);
+        return nearest;
+    }
+
+    memset(&p, 0, sizeof(p));
+    p.scale_mode = mode;
+    p.h_src = (int32_t)vi.xres;
+    p.v_src = (int32_t)vi.yres;
+    p.h_dst = panel_w;
+    p.v_dst = panel_h;
+    p.scale_cmd = ALIFB_GE_SET_SCALE_PARAM;
+    p.scale_param = (uint32_t)mode;
+    cmd = hwdisp_gma_ioctl_number();
+    errno = 0;
+    rv = ioctl(fd, cmd, &p);
+    saved_errno = errno;
+    close(fd);
+
+    DBG("DBG gma-scale: ioctl=0x%lx mode=%d %dx%d->%dx%d rv=%d errno=%d\n",
+        cmd, mode, p.h_src, p.v_src, p.h_dst, p.v_dst, rv, saved_errno);
+    if (rv < 0) {
+        g_gma_probe = 0;
+        g_gma_mode = -1;
+        return 0;
+    }
+
+    g_gma_probe = 1;
+    g_gma_mode = mode;
+    g_gma_hsrc = p.h_src;
+    g_gma_vsrc = p.v_src;
+    g_gma_hdst = p.h_dst;
+    g_gma_vdst = p.v_dst;
+    return nearest;
+}
+
+int hwdisp_gma_nearest_active(void)
+{
+    return g_gma_probe == 1 && g_gma_mode == ALIFB_GMA_RSZ_DIRECT_RESIZE;
+}
