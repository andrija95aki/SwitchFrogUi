+    switch (scale_mode) {
+        case SCALE_RAW_FIT:
+            /* Preserve the framebuffer's literal square-pixel aspect. */
+            if ((long long)w * 240 > (long long)h * 320) {
+                dh = (int)((long long)320 * h / w);
+                dy = (240 - dh) / 2;
+            } else {
+                dw = (int)((long long)240 * w / h);
+                dx = (320 - dw) / 2;
+            }
+            break;
+        case SCALE_INTEGER: {
+            /* Largest whole-number scale on the physical 640x480 panel. */
+            int mul = 640 / w;
+            int vmul = 480 / h;
+            if (vmul < mul) mul = vmul;
+            if (mul >= 1) {
+                dw = w * mul / 2;
+                dh = h * mul / 2;
+                if (dw < 1) dw = 1;
+                if (dh < 1) dh = 1;
+                dx = (320 - dw) / 2;
+                dy = (240 - dh) / 2;
+            } else {
+                /* Hi-res frame cannot fit at 1x: fall back to raw fit. */
+                if ((long long)w * 240 > (long long)h * 320) {
+                    dh = (int)((long long)320 * h / w);
+                    dy = (240 - dh) / 2;
+                } else {
+                    dw = (int)((long long)240 * w / h);
+                    dx = (320 - dw) / 2;
+                }
+            }
+            break;
+        }
+        case SCALE_NATIVE_1X:
+            /* One source pixel per physical panel pixel.  Canvas is presented
+             * at 2x, so source dimensions are halved here. */
+            dw = w / 2; dh = h / 2;
+            if (dw < 1) dw = 1;
+            if (dh < 1) dh = 1;
+            if (dw > 320) dw = 320;
+            if (dh > 240) dh = 240;
+            dx = (320 - dw) / 2;
+            dy = (240 - dh) / 2;
