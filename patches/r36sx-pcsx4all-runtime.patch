+        if (dn) sel = (sel + 1) % 5;
+        if (back) return;
+        if (!change) continue;
+        switch (sel) {
+            case 0: gpu_unai_config_ext.lighting = !gpu_unai_config_ext.lighting; break;
+            case 1: gpu_unai_config_ext.fast_lighting = !gpu_unai_config_ext.fast_lighting; break;
+            case 2: gpu_unai_config_ext.blending = !gpu_unai_config_ext.blending; break;
+            case 3: gpu_unai_config_ext.dithering = !gpu_unai_config_ext.dithering; break;
