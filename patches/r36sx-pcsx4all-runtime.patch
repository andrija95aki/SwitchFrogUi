+        snprintf(rows[2], sizeof rows[2], "Blending:       %s",
+                 gpu_unai_config_ext.blending ? "On" : "Off");
+        snprintf(rows[3], sizeof rows[3], "Dithering:      %s",
+                 gpu_unai_config_ext.dithering ? "On" : "Off");
+        snprintf(rows[4], sizeof rows[4], "Restore Accurate Defaults");
+        for (int i = 0; i < 5; i++) items[i] = rows[i];
