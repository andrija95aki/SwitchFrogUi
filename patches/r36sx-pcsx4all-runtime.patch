+                     (btn(k, CV_LEFT) && !btn(prev, CV_LEFT)) ||
+                     (btn(k, CV_RIGHT) && !btn(prev, CV_RIGHT));
+        int back = btn(k, CV_B) && !btn(prev, CV_B);
+        prev = k;
